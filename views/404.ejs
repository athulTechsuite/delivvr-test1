<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Not Found - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="md-body">
    <main class="md-main" role="main">
        <div class="md-container">
            <section class="md-section md-padding-top-lg md-padding-bottom-lg md-text-center" aria-labelledby="not-found-heading">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8">
                        <div class="md-card md-elevation-1 md-padding-xl md-text-center">
                            <div style="margin-bottom:1rem;">
                                <i class="bi bi-exclamation-octagon" aria-hidden="true" style="font-size:3rem;color:var(--primary,#FF6B00);"></i>
                            </div>
                            <h1 id="not-found-heading" class="md-headline-medium md-text-primary md-margin-bottom-sm">
                                Page Not Found
                            </h1>
                            <p class="md-body-medium md-text-secondary md-margin-bottom-lg">
                                The page or resource you requested could not be found.
                            </p>
                            <a href="/dashboard" class="md-button md-button--contained md-ripple md-padding-md md-border-radius-sm" role="button">
                                <i class="bi bi-house-fill md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                                <span>Back to Dashboard</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
