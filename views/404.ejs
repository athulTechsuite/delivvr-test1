<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <main class="md-main md-error-page" role="main" aria-labelledby="not-found-heading">
        <div class="md-error-page-content" role="alert" aria-live="polite">
            <div class="md-error-page-glyph" aria-hidden="true">
                <i class="bi bi-compass"></i>
            </div>
            <p class="md-error-page-code">404 &middot; Page Not Found</p>
            <h1 id="not-found-heading" class="md-error-page-title">
                We couldn't find that page
            </h1>
            <p class="md-error-page-body">
                The page or resource you requested doesn't exist or may have been moved.
                Let's get you back on track.
            </p>
            <div class="md-error-page-actions">
                <a href="/" class="md-btn md-button md-button--contained md-btn-primary">
                    <i class="bi bi-house-fill" aria-hidden="true"></i>
                    <span>Back to Home</span>
                </a>
                <a href="/dashboard" class="md-btn md-button md-button--outlined">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>Go to Dashboard</span>
                </a>
            </div>
        </div>
    </main>
    <script src="/js/theme-toggle.js"></script>
</body>
</html>
