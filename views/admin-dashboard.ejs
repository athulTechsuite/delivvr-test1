<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr Admin</span>
                </a>
            </div>
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/admin" role="menuitem" aria-current="page">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            Admin Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            My Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="md-main" role="main">
        <div class="md-container">
            <section class="md-section md-padding-top-lg md-padding-bottom-md" aria-labelledby="admin-heading">
                <div class="md-row">
                    <div class="md-col-12">
                        <div class="md-dashboard-welcome" role="banner">
                            <div style="display:flex;align-items:center;gap:1rem;position:relative;z-index:1;">
                                <i class="bi bi-shield-lock" aria-hidden="true" style="font-size:2.5rem;"></i>
                                <div>
                                    <h2 id="admin-heading" style="margin:0;font-size:1.75rem;font-weight:700;">
                                        Admin Dashboard
                                    </h2>
                                    <p style="margin:0.25rem 0 0;opacity:0.85;">
                                        All orders across all users — <%= orders.length %> total
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="orders-table-heading">
                <div class="md-row">
                    <div class="md-col-12">
                        <div class="md-card md-elevation-2 md-border-radius-md">
                            <div class="md-card-header md-bg-primary md-padding-md">
                                <h2 id="orders-table-heading" class="md-card-title md-headline-small md-text-primary-on-primary md-margin-none">
                                    <i class="bi bi-list-ul md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                                    All Orders
                                </h2>
                            </div>
                            <div class="md-card-content md-padding-none" style="overflow-x:auto;">
                                <% if (orders.length === 0) { %>
                                    <p class="md-body-large md-text-secondary md-padding-lg">No orders found.</p>
                                <% } else { %>
                                <table class="md-table" style="width:100%;border-collapse:collapse;">
                                    <thead>
                                        <tr>
                                            <th class="md-table-header md-padding-md">Order ID</th>
                                            <th class="md-table-header md-padding-md">Customer</th>
                                            <th class="md-table-header md-padding-md">Pickup</th>
                                            <th class="md-table-header md-padding-md">Delivery</th>
                                            <th class="md-table-header md-padding-md">Status</th>
                                            <th class="md-table-header md-padding-md">Created</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% orders.forEach(function(order) { %>
                                        <tr class="md-table-row">
                                            <td class="md-table-cell md-padding-md">#<%= order.id %></td>
                                            <td class="md-table-cell md-padding-md">
                                                <span><%= order.user_name %></span><br>
                                                <small class="md-text-secondary"><%= order.user_email %></small>
                                            </td>
                                            <td class="md-table-cell md-padding-md"><%= order.pickup_address %></td>
                                            <td class="md-table-cell md-padding-md"><%= order.delivery_address %></td>
                                            <td class="md-table-cell md-padding-md">
                                                <span class="md-chip md-chip-<%= order.status %>">
                                                    <%= order.status %>
                                                </span>
                                            </td>
                                            <td class="md-table-cell md-padding-md">
                                                <%= new Date(order.created_at).toLocaleString() %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="/js/theme-toggle.js"></script>
</body>
</html>
