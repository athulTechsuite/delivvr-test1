<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>

            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
            </button>

            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/orders" role="menuitem" aria-current="page">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            My Orders
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders/new" role="menuitem">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            New Order
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <section class="md-section md-padding-top-lg md-padding-bottom-md" aria-labelledby="orders-heading">
                <div class="md-row md-align-items-center md-justify-content-space-between">
                    <div class="md-col-12 md-col-md-8">
                        <h1 id="orders-heading" class="md-headline-medium md-text-primary md-margin-bottom-xs">
                            <i class="bi bi-box-seam md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                            My Orders
                        </h1>
                        <p class="md-body-medium md-text-secondary md-margin-0">
                            View and track all of your delivery orders.
                        </p>
                    </div>
                    <div class="md-col-12 md-col-md-4 md-text-md-right md-margin-top-md">
                        <a href="/orders/new" class="md-button md-button--contained md-ripple md-padding-md md-border-radius-sm" role="button">
                            <i class="bi bi-plus-circle md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                            <span>New Order</span>
                        </a>
                    </div>
                </div>
            </section>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="orders-list-heading">
                <h2 id="orders-list-heading" class="md-visually-hidden">Orders list</h2>

                <% if (!orders || orders.length === 0) { %>
                    <div class="md-row md-justify-center">
                        <div class="md-col-12 md-col-md-8">
                            <div class="md-card md-elevation-1 md-text-center md-padding-xl">
                                <div style="margin-bottom:1rem;">
                                    <i class="bi bi-inbox" aria-hidden="true" style="font-size:3rem;color:var(--primary,#FF6B00);"></i>
                                </div>
                                <h3 class="md-headline-small md-text-primary md-margin-bottom-sm">
                                    No orders yet
                                </h3>
                                <p class="md-body-medium md-text-secondary md-margin-bottom-lg">
                                    You haven't placed any delivery orders. Create your first one now.
                                </p>
                                <a href="/orders/new" class="md-button md-button--contained md-ripple md-padding-md md-border-radius-sm" role="button">
                                    <i class="bi bi-plus-circle md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                                    <span>Place Your First Order</span>
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="md-row md-gutter-md">
                        <% orders.forEach(function(order) {
                            var statusRaw = (order && typeof order.status === 'string') ? order.status : 'pending';
                            var statusLabel = statusRaw.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
                            var chipClass = 'md-chip';
                            if (statusRaw === 'pending') { chipClass += ' md-chip-pending'; }
                            else if (statusRaw === 'delivered') { chipClass += ' md-chip-delivered'; }
                            else if (statusRaw === 'cancelled') { chipClass += ' md-chip-cancelled'; }
                            else { chipClass += ' md-chip-active'; }
                            var createdAt = order && order.created_at ? new Date(order.created_at) : null;
                            var createdLabel = createdAt && !isNaN(createdAt.getTime()) ? createdAt.toLocaleString() : '—';
                            var description = (order && typeof order.package_description === 'string' && order.package_description.trim().length > 0)
                                ? order.package_description
                                : null;
                        %>
                            <div class="md-col-12 md-col-md-6 md-col-lg-4 md-margin-bottom-md">
                                <a href="/orders/<%= order.id %>" class="md-order-card-link" aria-label="View order <%= order.id %> details" style="display:block;text-decoration:none;color:inherit;transition:transform 0.2s ease, box-shadow 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 18px rgba(0,0,0,0.12)';" onmouseout="this.style.transform='';this.style.boxShadow='';">
                                <article class="md-card md-elevation-2 md-border-radius-md" aria-label="Order <%= order.id %>">
                                    <div class="md-card-header md-padding-md md-display-flex md-justify-content-space-between md-align-items-center">
                                        <h3 class="md-card-title md-headline-small md-margin-none md-text-on-primary">
                                            <i class="bi bi-hash" aria-hidden="true"></i>
                                            Order <%= order.id %>
                                        </h3>
                                        <span class="<%= chipClass %>" aria-label="Status: <%= statusLabel %>">
                                            <i class="bi bi-circle-fill" aria-hidden="true" style="font-size:0.5rem;margin-right:0.35rem;"></i>
                                            <%= statusLabel %>
                                        </span>
                                    </div>
                                    <div class="md-card-content md-padding-lg">
                                        <div class="md-margin-bottom-md">
                                            <div class="md-display-flex md-align-items-center md-margin-bottom-xs">
                                                <i class="bi bi-geo-alt md-icon-small md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                                <span class="md-body-medium md-text-secondary md-font-weight-medium">Pickup</span>
                                            </div>
                                            <div class="md-body-large md-text-primary md-padding-left-lg">
                                                <%= order.pickup_address %>
                                            </div>
                                        </div>

                                        <div class="md-margin-bottom-md">
                                            <div class="md-display-flex md-align-items-center md-margin-bottom-xs">
                                                <i class="bi bi-geo-alt-fill md-icon-small md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                                <span class="md-body-medium md-text-secondary md-font-weight-medium">Delivery</span>
                                            </div>
                                            <div class="md-body-large md-text-primary md-padding-left-lg">
                                                <%= order.delivery_address %>
                                            </div>
                                        </div>

                                        <div class="md-margin-bottom-md">
                                            <div class="md-display-flex md-align-items-center md-margin-bottom-xs">
                                                <i class="bi bi-card-text md-icon-small md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                                <span class="md-body-medium md-text-secondary md-font-weight-medium">Description</span>
                                            </div>
                                            <div class="md-body-large md-text-primary md-padding-left-lg">
                                                <% if (description) { %>
                                                    <%= description %>
                                                <% } else { %>
                                                    <span class="md-text-secondary">—</span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="md-display-flex md-align-items-center md-margin-bottom-xs">
                                                <i class="bi bi-calendar-date md-icon-small md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                                <span class="md-body-medium md-text-secondary md-font-weight-medium">Placed</span>
                                            </div>
                                            <div class="md-body-medium md-text-primary md-padding-left-lg">
                                                <%= createdLabel %>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>

    <script src="/js/theme-toggle.js"></script>
    <script>
        (function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
            }
        })();
    </script>
</body>
</html>
