<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <a href="#login-form" class="skip-link sr-only">Skip to login form</a>
    <main class="md-auth-shell" role="main">
        <section class="md-auth-card" aria-labelledby="login-heading">
            <header class="md-auth-brand">
                <div class="md-auth-brand-mark" aria-hidden="true">
                    <i class="bi bi-truck"></i>
                </div>
                <h1 id="login-heading" class="md-auth-title">Welcome to Delivvr</h1>
                <p class="md-auth-subtitle">Sign in to manage your deliveries</p>
            </header>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="md-alert md-alert--error md-alert-error md-margin-bottom-md" role="alert" aria-live="polite">
                    <div class="md-alert-content">
                        <i class="bi bi-exclamation-triangle-fill md-alert-icon" aria-hidden="true"></i>
                        <span class="md-alert-message"><%= error %></span>
                    </div>
                </div>
            <% } %>

            <form id="login-form" action="/login" method="POST" class="md-form" novalidate aria-labelledby="login-heading">
                <div class="md-form-field md-margin-bottom-md">
                    <div class="md-form-group">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            autocomplete="email"
                            aria-describedby="email-error"
                            aria-invalid="false"
                        >
                        <label class="md-form-label" for="email">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            Email Address
                        </label>
                    </div>
                    <div id="email-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <div class="md-form-field md-margin-bottom-lg">
                    <div class="md-form-group">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            autocomplete="current-password"
                            aria-describedby="password-error"
                            aria-invalid="false"
                        >
                        <label class="md-form-label" for="password">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            Password
                        </label>
                        <button
                            type="button"
                            class="md-input-toggle-password"
                            aria-label="Show password"
                            tabindex="-1"
                            data-toggle-password
                        >
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="password-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <button
                    type="submit"
                    class="md-btn md-button md-btn-primary md-button--contained md-btn-block md-button--full-width md-button--large"
                    id="submitButton"
                >
                    <span class="md-button-label">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        Sign In
                    </span>
                </button>
            </form>

            <footer class="md-auth-footer">
                <p class="md-margin-none">
                    Don't have an account?
                    <a href="/signup" class="md-link">Create one here</a>
                </p>
            </footer>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('login-form');
            if (!form) { return; }
            var inputs = form.querySelectorAll('.md-form-control');
            var submitButton = document.getElementById('submitButton');

            // Password visibility toggle
            var passwordToggle = document.querySelector('[data-toggle-password]');
            if (passwordToggle) {
                var passwordInput = document.getElementById('password');
                var toggleIcon = passwordToggle.querySelector('i');
                passwordToggle.addEventListener('click', function () {
                    var isPassword = passwordInput.type === 'password';
                    passwordInput.type = isPassword ? 'text' : 'password';
                    toggleIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    passwordToggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                });
            }

            function validateInput(input) {
                var errorId = input.getAttribute('aria-describedby');
                var errorElement = errorId ? document.getElementById(errorId) : null;
                var msg = '';
                if (input.hasAttribute('required') && !input.value.trim()) {
                    msg = (input.name.charAt(0).toUpperCase() + input.name.slice(1)) + ' is required';
                } else if (input.type === 'email' && input.value.trim()) {
                    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(input.value.trim())) {
                        msg = 'Please enter a valid email address';
                    }
                }
                if (errorElement) {
                    errorElement.textContent = msg;
                }
                input.setAttribute('aria-invalid', msg ? 'true' : 'false');
                return !msg;
            }

            inputs.forEach(function (input) {
                input.addEventListener('blur', function () { validateInput(input); });
                input.addEventListener('input', function () {
                    if (input.value.trim()) {
                        var errorId = input.getAttribute('aria-describedby');
                        var errorElement = errorId ? document.getElementById(errorId) : null;
                        if (errorElement) { errorElement.textContent = ''; }
                        input.setAttribute('aria-invalid', 'false');
                    }
                });
            });

            form.addEventListener('submit', function (e) {
                var allValid = true;
                inputs.forEach(function (input) {
                    if (!validateInput(input)) { allValid = false; }
                });
                if (!allValid) {
                    e.preventDefault();
                    return;
                }
                submitButton.disabled = true;
                var label = submitButton.querySelector('.md-button-label');
                if (label) {
                    label.innerHTML = '<i class="bi bi-hourglass-split" aria-hidden="true"></i> Signing in...';
                }
            });
        });
    </script>
    <script src="/js/theme-toggle.js"></script>
</body>
</html>
