<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Authentication App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" href="/">Auth App</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/signup">Sign Up</a>
                <a class="nav-link active" href="/login">Login</a>
                <button class="btn btn-outline-light ms-2" type="button" id="themeToggle">
                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                    <span id="themeText">Light</span>
                </button>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="text-center">Login</h3>
                    </div>
                    <div class="card-body">
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger" role="alert">
                                <%= error %>
                            </div>
                        <% } %>
                        
                        <form action="/login" method="POST">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Login</button>
                            </div>
                        </form>
                        
                        <div class="text-center mt-3">
                            <p>Don't have an account? <a href="/signup">Sign up here</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    
    <script>
        // Theme Manager
        class ThemeManager {
            constructor() {
                this.init();
            }

            init() {
                // Load saved theme or default to light
                const savedTheme = localStorage.getItem('theme') || 'light';
                this.setTheme(savedTheme);
                this.updateToggleButton(savedTheme);
                this.bindEvents();
            }

            setTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('theme', theme);
                
                // Update navbar styling based on theme
                const navbar = document.querySelector('.navbar');
                if (theme === 'dark') {
                    navbar.className = 'navbar navbar-expand-lg navbar-dark bg-dark';
                    navbar.setAttribute('data-bs-theme', 'dark');
                } else {
                    navbar.className = 'navbar navbar-expand-lg navbar-light bg-light';
                    navbar.setAttribute('data-bs-theme', 'light');
                }
            }

            updateToggleButton(theme) {
                const themeIcon = document.getElementById('themeIcon');
                const themeText = document.getElementById('themeText');
                const themeToggle = document.getElementById('themeToggle');
                
                if (theme === 'dark') {
                    themeIcon.className = 'bi bi-moon-fill';
                    themeText.textContent = 'Dark';
                    themeToggle.className = 'btn btn-outline-light ms-2';
                } else {
                    themeIcon.className = 'bi bi-sun-fill';
                    themeText.textContent = 'Light';
                    themeToggle.className = 'btn btn-outline-dark ms-2';
                }
            }

            toggleTheme() {
                const currentTheme = document.documentElement.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                this.setTheme(newTheme);
                this.updateToggleButton(newTheme);
            }

            bindEvents() {
                const themeToggle = document.getElementById('themeToggle');
                themeToggle.addEventListener('click', () => this.toggleTheme());
            }
        }

        // Initialize theme manager when DOM is loaded
        document.addEventListener('DOMContentLoaded', () => {
            new ThemeManager();
        });
    </script>
</body>
</html>