<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Express Auth App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- Mobile Hamburger Button -->
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle navigation">
        <i class="bi bi-list" id="hamburgerIcon"></i>
    </button>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Side Navigation -->
    <nav class="sidebar" id="sidebar">
        <div class="p-3 text-white">
            <h4 class="mb-0">Express Auth</h4>
            <% if (typeof user !== 'undefined' && user) { %>
                <small class="text-muted">Welcome, <%= user.name %></small>
            <% } %>
        </div>
        <ul class="sidebar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/dashboard">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/profile">
                    <i class="bi bi-person"></i>
                    Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/settings">
                    <i class="bi bi-gear"></i>
                    Settings
                </a>
            </li>
            <li class="nav-item">
                <form method="POST" action="/logout" class="m-0">
                    <button type="submit" class="nav-link">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Flash Messages -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h1 class="h2 mb-4">Settings</h1>
                    
                    <% if (typeof user !== 'undefined' && user) { %>
                        <p class="lead mb-4">
                            <i class="bi bi-gear me-2"></i>
                            Welcome, <%- user.name %>! Configure your application settings below.
                        </p>
                    <% } %>
                    
                    <!-- General Settings Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3><i class="bi bi-sliders me-2"></i>General Settings</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Configure your application preferences</p>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Language</label>
                                <select class="form-select" disabled>
                                    <option selected>English (US)</option>
                                    <option>Spanish</option>
                                    <option>French</option>
                                    <option>German</option>
                                </select>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="darkModeSwitch" checked disabled>
                                <label class="form-check-label" for="darkModeSwitch">
                                    Enable Dark Mode
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="animationsSwitch" checked disabled>
                                <label class="form-check-label" for="animationsSwitch">
                                    Enable Animations
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Security Settings Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3><i class="bi bi-shield-check me-2"></i>Security Settings</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Manage security preferences and authentication settings</p>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="twoFactorSwitch" disabled>
                                <label class="form-check-label" for="twoFactorSwitch">
                                    Enable Two-Factor Authentication
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="loginAlertsSwitch" checked disabled>
                                <label class="form-check-label" for="loginAlertsSwitch">
                                    Email Alerts for New Logins
                                </label>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Session Timeout</label>
                                <select class="form-select" disabled>
                                    <option>15 minutes</option>
                                    <option selected>30 minutes</option>
                                    <option>1 hour</option>
                                    <option>4 hours</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Notification Preferences Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3><i class="bi bi-bell me-2"></i>Notification Preferences</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Control how and when you receive notifications</p>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="emailNotificationsSwitch" checked disabled>
                                <label class="form-check-label" for="emailNotificationsSwitch">
                                    Email Notifications
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="browserNotificationsSwitch" disabled>
                                <label class="form-check-label" for="browserNotificationsSwitch">
                                    Browser Push Notifications
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="weeklyDigestSwitch" checked disabled>
                                <label class="form-check-label" for="weeklyDigestSwitch">
                                    Weekly Activity Digest
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="marketingEmailsSwitch" disabled>
                                <label class="form-check-label" for="marketingEmailsSwitch">
                                    Marketing Emails
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Account Management Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3><i class="bi bi-person-gear me-2"></i>Account Management</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Manage your account settings and data</p>
                            
                            <div class="mb-3">
                                <button class="btn btn-outline-primary me-2" disabled>
                                    <i class="bi bi-download me-1"></i>
                                    Export Data
                                </button>
                                <button class="btn btn-outline-warning me-2" disabled>
                                    <i class="bi bi-key me-1"></i>
                                    Change Password
                                </button>
                                <button class="btn btn-outline-danger" disabled>
                                    <i class="bi bi-trash me-1"></i>
                                    Delete Account
                                </button>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="dataCollectionSwitch" checked disabled>
                                <label class="form-check-label" for="dataCollectionSwitch">
                                    Allow Data Collection for Analytics
                                </label>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="publicProfileSwitch" disabled>
                                <label class="form-check-label" for="publicProfileSwitch">
                                    Make Profile Public
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Save Settings Button -->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary btn-lg" disabled>
                            <i class="bi bi-floppy me-2"></i>
                            Save Settings
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const hamburgerBtn = document.getElementById('hamburgerBtn');
            const hamburgerIcon = document.getElementById('hamburgerIcon');
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            if (hamburgerBtn && sidebar && sidebarOverlay) {
                hamburgerBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                    sidebarOverlay.classList.toggle('show');
                    
                    // Toggle hamburger icon
                    if (sidebar.classList.contains('show')) {
                        hamburgerIcon.className = 'bi bi-x';
                    } else {
                        hamburgerIcon.className = 'bi bi-list';
                    }
                });

                // Close sidebar when clicking overlay
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                    hamburgerIcon.className = 'bi bi-list';
                });
            }
        });
    </script>
</body>
</html>