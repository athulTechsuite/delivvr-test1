<%- include('authenticated-layout', { 
    title: 'Settings',
    currentPage: 'settings',
    content: `
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">Settings</h1>
        </div>
        
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Account Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            This is a placeholder settings page. No functionality has been implemented yet.
                        </div>
                        
                        <form>
                            <div class="mb-3">
                                <label for="emailNotifications" class="form-label">Email Notifications</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="emailNotifications" disabled>
                                    <label class="form-check-label" for="emailNotifications">
                                        Receive email notifications
                                    </label>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="language" class="form-label">Language</label>
                                <select class="form-select" id="language" disabled>
                                    <option selected>English</option>
                                    <option value="es">Spanish</option>
                                    <option value="fr">French</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label for="timezone" class="form-label">Timezone</label>
                                <select class="form-select" id="timezone" disabled>
                                    <option selected>UTC-5 (Eastern Time)</option>
                                    <option value="utc-8">UTC-8 (Pacific Time)</option>
                                    <option value="utc-6">UTC-6 (Central Time)</option>
                                </select>
                            </div>
                            
                            <button type="button" class="btn btn-primary" disabled>Save Settings</button>
                            <button type="button" class="btn btn-secondary ms-2" disabled>Reset</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Privacy & Security</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary" disabled>
                                <i class="fas fa-key me-2"></i>Change Password
                            </button>
                            <button type="button" class="btn btn-outline-warning" disabled>
                                <i class="fas fa-shield-alt me-2"></i>Two-Factor Auth
                            </button>
                            <button type="button" class="btn btn-outline-danger" disabled>
                                <i class="fas fa-user-times me-2"></i>Delete Account
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}) %>