<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Express Auth App</title>
    <!-- Material Design Compatible Styling -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,0,1;wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Sidebar Toggle Button for Mobile -->
    <div class="md-mobile-header">
        <button class="md-btn md-btn-icon md-btn-primary md-sidebar-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>
        <h5 class="md-mobile-title">
            <i class="bi bi-shield-lock"></i> Express Auth App
        </h5>
    </div>

    <!-- Sidebar Navigation -->
    <div class="md-sidebar" id="sidebar" aria-labelledby="sidebarLabel">
        <div class="md-sidebar-header">
            <h5 class="md-sidebar-title" id="sidebarLabel">
                <i class="bi bi-shield-lock"></i> Express Auth App
            </h5>
            <button type="button" class="md-sidebar-close md-btn md-btn-icon" aria-label="Close sidebar">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="md-sidebar-body">
            <nav class="md-nav-menu" role="navigation">
                <a class="md-nav-link <%= (typeof title !== 'undefined' && title === 'Home') ? 'md-nav-link-active' : '' %>" href="/" role="menuitem">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>
                
                <% if (typeof user !== 'undefined' && user !== null && user) { %>
                    <div class="md-user-info">
                        <small class="md-user-label">Signed in as:</small>
                        <div class="md-user-name">
                            <i class="bi bi-person-circle"></i>
                            <span><%= user.name || user.username || 'Unknown User' %></span>
                        </div>
                    </div>
                    
                    <a class="md-nav-link <%= (typeof title !== 'undefined' && title === 'Profile') ? 'md-nav-link-active' : '' %>" href="/profile" role="menuitem">
                        <i class="bi bi-person-circle"></i>
                        <span>Profile</span>
                    </a>
                    
                    <a class="md-nav-link <%= (typeof title !== 'undefined' && title === 'Dashboard') ? 'md-nav-link-active' : '' %>" href="/dashboard" role="menuitem">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    <form action="/logout" method="POST" class="md-nav-form">
                        <button type="submit" class="md-nav-link md-nav-button" role="menuitem">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                <% } else { %>
                    <a class="md-nav-link <%= (typeof title !== 'undefined' && title === 'Login') ? 'md-nav-link-active' : '' %>" href="/login" role="menuitem">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>
                    </a>
                    
                    <a class="md-nav-link <%= (typeof title !== 'undefined' && title === 'Sign Up') ? 'md-nav-link-active' : '' %>" href="/signup" role="menuitem">
                        <i class="bi bi-person-plus"></i>
                        <span>Sign Up</span>
                    </a>
                <% } %>
            </nav>
        </div>
    </div>

    <!-- Sidebar Overlay -->
    <div class="md-sidebar-overlay" id="sidebar-overlay"></div>

    <!-- Main Content Wrapper -->
    <div class="md-main-wrapper">
        <!-- Flash Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="md-container md-margin-top-md">
                <div class="md-alert md-alert-error" role="alert">
                    <div class="md-alert-content">
                        <i class="bi bi-exclamation-triangle md-alert-icon" aria-hidden="true"></i>
                        <span class="md-alert-message"><%= error %></span>
                        <button type="button" class="md-alert-close" aria-label="Close alert">
                            <i class="bi bi-x" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="md-container md-margin-top-md">
                <div class="md-alert md-alert-success" role="alert">
                    <div class="md-alert-content">
                        <i class="bi bi-check-circle md-alert-icon" aria-hidden="true"></i>
                        <span class="md-alert-message"><%= success %></span>
                        <button type="button" class="md-alert-close" aria-label="Close alert">
                            <i class="bi bi-x" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Main Content -->
        <main class="md-main-content" role="main">
            <%- body %>
        </main>

        <!-- Footer -->
        <footer class="md-footer" role="contentinfo">
            <div class="md-container">
                <div class="md-footer-content">
                    <p class="md-footer-text">&copy; 2024 Express Auth App. Built with Material Design principles.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Material Design JavaScript for Interactive Components -->
    <script>
        // Material Design Alert Close Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const alertCloseButtons = document.querySelectorAll('.md-alert-close');
            alertCloseButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    const alert = this.closest('.md-alert');
                    if (alert) {
                        alert.style.opacity = '0';
                        alert.style.transform = 'translateY(-8px)';
                        setTimeout(function() {
                            alert.remove();
                        }, 300);
                    }
                });
            });

            // Material Design Ripple Effect for Navigation Links
            const navLinks = document.querySelectorAll('.md-nav-link, .md-btn');
            navLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;
                    
                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.classList.add('md-ripple');
                    
                    this.appendChild(ripple);
                    
                    setTimeout(function() {
                        ripple.remove();
                    }, 600);
                });
            });

            // Custom Material Design Sidebar Functionality
            const sidebarToggle = document.querySelector('.md-sidebar-toggle');
            const sidebar = document.querySelector('.md-sidebar');
            const sidebarClose = document.querySelector('.md-sidebar-close');
            const sidebarOverlay = document.querySelector('.md-sidebar-overlay');

            function showSidebar() {
                sidebar.classList.add('md-sidebar-open');
                sidebarOverlay.classList.add('md-sidebar-overlay-active');
                document.body.style.overflow = 'hidden';
                sidebarToggle.setAttribute('aria-expanded', 'true');
            }

            function hideSidebar() {
                sidebar.classList.remove('md-sidebar-open');
                sidebarOverlay.classList.remove('md-sidebar-overlay-active');
                document.body.style.overflow = '';
                sidebarToggle.setAttribute('aria-expanded', 'false');
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', showSidebar);
            }

            if (sidebarClose) {
                sidebarClose.addEventListener('click', hideSidebar);
            }

            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', hideSidebar);
            }

            // Close sidebar on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && sidebar.classList.contains('md-sidebar-open')) {
                    hideSidebar();
                }
            });

            // Close sidebar on window resize to large screen
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 992) {
                    hideSidebar();
                }
            });

            // Handle navigation links accessibility
            const navMenuLinks = document.querySelectorAll('.md-nav-link');
            navMenuLinks.forEach(function(link) {
                link.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });
        });
    </script>
</body>
</html>