<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Auth App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }
        
        .main-wrapper {
            margin-left: 250px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .content-area {
            flex: 1;
        }
        
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 0.75rem 1.5rem;
            border-radius: 0;
            transition: all 0.3s ease;
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link:focus {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        .sidebar .navbar-brand {
            color: white;
            font-size: 1.25rem;
            font-weight: 600;
            padding: 1.5rem;
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 1rem;
        }
        
        .sidebar .navbar-brand:hover {
            color: white;
        }

        /* Prevent sidebar from collapsing on any screen size */
        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                width: 250px;
                display: flex !important;
            }
            .main-wrapper {
                margin-left: 250px;
            }
        }
        
        @media (max-width: 576px) {
            .sidebar {
                position: fixed;
                width: 250px;
                display: flex !important;
            }
            .main-wrapper {
                margin-left: 250px;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Fixed Sidebar Navigation -->
        <nav class="sidebar bg-primary text-white d-flex flex-column" role="navigation" aria-label="Main navigation">
            <a class="navbar-brand d-flex align-items-center" href="/" aria-label="Auth App Home">
                <i class="bi bi-shield-lock me-2"></i>
                Auth App
            </a>
            
            <div class="flex-grow-1">
                <ul class="nav nav-pills flex-column" role="menubar">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item" role="none">
                            <a class="nav-link d-flex align-items-center" href="/dashboard" role="menuitem" aria-label="Dashboard">
                                <i class="bi bi-house me-2"></i>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link d-flex align-items-center" href="/logout" role="menuitem" aria-label="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                Logout
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item" role="none">
                            <a class="nav-link d-flex align-items-center" href="/login" role="menuitem" aria-label="Login">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Login
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link d-flex align-items-center" href="/signup" role="menuitem" aria-label="Sign Up">
                                <i class="bi bi-person-plus me-2"></i>
                                Sign Up
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </nav>

        <!-- Main Content Wrapper -->
        <div class="main-wrapper">
            <div class="content-area">
                <!-- Flash Messages -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="container-fluid mt-3">
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                <% } %>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="container-fluid mt-3">
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                <% } %>

                <!-- Main Content -->
                <main class="container-fluid mt-4" role="main">
                    <%- body %>
                </main>
            </div>

            <!-- Footer -->
            <footer class="bg-light text-center text-muted py-4 mt-5" role="contentinfo">
                <div class="container-fluid">
                    <p class="mb-0">&copy; 2024 Auth App. Built with Express.js & Bootstrap.</p>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>