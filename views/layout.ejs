<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Auth App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- Hamburger Menu Button (Mobile Only) -->
    <button class="btn btn-dark d-lg-none sidebar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list"></i>
    </button>

    <!-- Side Navigation -->
    <nav id="sidebar" class="sidebar collapse d-lg-block bg-dark">
        <div class="sidebar-content">
            <!-- Brand -->
            <div class="sidebar-brand">
                <a class="navbar-brand text-white text-decoration-none" href="/">
                    <i class="bi bi-shield-lock"></i> Auth App
                </a>
            </div>
            
            <!-- Navigation Links -->
            <ul class="nav flex-column sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link text-white <%= title === 'Home' ? 'active' : '' %>" href="/" data-bs-toggle="collapse" data-bs-target="#sidebar.collapse.show">
                        <i class="bi bi-house"></i> Home
                    </a>
                </li>
                
                <% if (typeof user !== 'undefined' && user) { %>
                    <li class="nav-item">
                        <a class="nav-link text-white <%= title === 'Dashboard' ? 'active' : '' %>" href="/dashboard" data-bs-toggle="collapse" data-bs-target="#sidebar.collapse.show">
                            <i class="bi bi-person-circle"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <form method="POST" action="/logout" class="d-inline">
                            <button type="submit" class="nav-link text-white <%= title === 'Logout' ? 'active' : '' %> btn btn-link text-start w-100 border-0 p-0" style="padding: 0.75rem 1.5rem !important; text-decoration: none;">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link text-white <%= title === 'Login' ? 'active' : '' %>" href="/login" data-bs-toggle="collapse" data-bs-target="#sidebar.collapse.show">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white <%= title === 'Sign Up' ? 'active' : '' %>" href="/signup" data-bs-toggle="collapse" data-bs-target="#sidebar.collapse.show">
                            <i class="bi bi-person-plus"></i> Sign Up
                        </a>
                    </li>
                <% } %>
            </ul>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-content">
        <!-- Flash Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        <% } %>

        <!-- Main Content -->
        <main class="container mt-4">
            <%- body %>
        </main>

        <!-- Footer -->
        <footer class="bg-light text-center text-muted py-4 mt-5">
            <div class="container">
                <p class="mb-0">&copy; 2024 Auth App. Built with Express.js & Bootstrap.</p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-collapse sidebar on mobile after link click
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarLinks = document.querySelectorAll('#sidebar .nav-link, #sidebar button[type="submit"]');
            const sidebar = document.getElementById('sidebar');
            
            sidebarLinks.forEach(function(element) {
                element.addEventListener('click', function() {
                    // Only collapse on mobile screens
                    if (window.innerWidth < 992) {
                        // Check if sidebar is currently shown
                        if (sidebar.classList.contains('show')) {
                            const bsCollapse = new bootstrap.Collapse(sidebar, {
                                toggle: false
                            });
                            bsCollapse.hide();
                        }
                    }
                });
            });

            // Handle window resize to ensure proper sidebar state
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 992) {
                    // On desktop, ensure sidebar is always visible
                    if (!sidebar.classList.contains('show')) {
                        sidebar.classList.add('show');
                    }
                }
            });
        });
    </script>
</body>
</html>