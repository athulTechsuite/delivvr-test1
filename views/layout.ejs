<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Auth App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- Sidebar Toggle Button for Mobile -->
    <div class="d-lg-none p-3 bg-primary">
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list"></i> Menu
        </button>
    </div>

    <!-- Sidebar Navigation -->
    <div class="offcanvas-lg offcanvas-start bg-primary" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
        <div class="offcanvas-header border-bottom border-light">
            <h5 class="offcanvas-title text-white" id="sidebarLabel">
                <i class="bi bi-shield-lock"></i> Auth App
            </h5>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <nav class="nav flex-column">
                <a class="nav-link text-white <%= (typeof title !== 'undefined' && title === 'Home') ? 'active bg-primary-dark' : '' %>" href="/">
                    <i class="bi bi-house"></i> Home
                </a>
                
                <% if (typeof user !== 'undefined' && user !== null && user) { %>
                    <div class="px-3 py-2 border-bottom border-light">
                        <small class="text-white-50">Signed in as:</small>
                        <div class="text-white fw-bold">
                            <i class="bi bi-person-circle"></i> <%= user?.username || 'Unknown User' %>
                        </div>
                    </div>
                    
                    <a class="nav-link text-white <%= (typeof title !== 'undefined' && title === 'Dashboard') ? 'active bg-primary-dark' : '' %>" href="/dashboard">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    
                    <form action="/auth/logout" method="POST" class="d-inline">
                        <button type="submit" class="nav-link text-white btn btn-link text-start w-100 border-0 p-0" style="text-decoration: none;">
                            <span class="d-block px-3 py-2">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </span>
                        </button>
                    </form>
                <% } else { %>
                    <a class="nav-link text-white <%= (typeof title !== 'undefined' && title === 'Login') ? 'active bg-primary-dark' : '' %>" href="/login">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    
                    <a class="nav-link text-white <%= (typeof title !== 'undefined' && title === 'Sign Up') ? 'active bg-primary-dark' : '' %>" href="/signup">
                        <i class="bi bi-person-plus"></i> Sign Up
                    </a>
                <% } %>
            </nav>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="main-content">
        <!-- Flash Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        <% } %>

        <!-- Main Content -->
        <main class="container mt-4">
            <%- body %>
        </main>

        <!-- Footer -->
        <footer class="bg-light text-center text-muted py-4 mt-5">
            <div class="container">
                <p class="mb-0">&copy; 2024 Auth App. Built with Express.js & Bootstrap.</p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>