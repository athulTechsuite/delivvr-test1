<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Users - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="md-body">
    <main class="md-main" role="main">
        <div class="md-container md-padding-top-lg md-padding-bottom-lg">
            <div class="md-row md-justify-between md-align-center md-margin-bottom-lg">
                <h1 class="md-headline-medium md-text-primary">
                    <i class="bi bi-people-fill md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                    User Management
                </h1>
                <div style="display:flex;gap:0.5rem;">
                    <a href="/admin/orders" class="md-button md-button--outlined md-ripple md-padding-sm md-border-radius-sm">
                        <i class="bi bi-clipboard-data md-icon-small md-margin-right-xs" aria-hidden="true"></i>
                        All Orders
                    </a>
                    <a href="/dashboard" class="md-button md-button--outlined md-ripple md-padding-sm md-border-radius-sm">
                        <i class="bi bi-house-fill md-icon-small md-margin-right-xs" aria-hidden="true"></i>
                        Dashboard
                    </a>
                </div>
            </div>
            <% if (!users || users.length === 0) { %>
                <div class="md-card md-elevation-1 md-padding-xl md-text-center">
                    <i class="bi bi-people" aria-hidden="true" style="font-size:2rem;color:var(--primary,#FF6B00);"></i>
                    <p class="md-body-medium md-text-secondary md-margin-top-sm">No users found.</p>
                </div>
            <% } else { %>
                <div class="md-card md-elevation-1">
                    <table class="md-table" style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th class="md-table-header">ID</th>
                                <th class="md-table-header">Name</th>
                                <th class="md-table-header">Email</th>
                                <th class="md-table-header">Role</th>
                                <th class="md-table-header">Member Since</th>
                                <th class="md-table-header">Change Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(u) { %>
                                <tr class="md-table-row">
                                    <td class="md-table-cell"><%= u.id %></td>
                                    <td class="md-table-cell"><%= u.name %></td>
                                    <td class="md-table-cell"><%= u.email %></td>
                                    <td class="md-table-cell">
                                        <span class="md-badge <%= u.role === 'admin' ? 'md-badge--primary' : '' %>">
                                            <%= u.role %>
                                        </span>
                                    </td>
                                    <td class="md-table-cell"><%= new Date(u.created_at).toLocaleDateString() %></td>
                                    <td class="md-table-cell">
                                        <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:flex;gap:0.5rem;align-items:center;">
                                            <select name="role" class="md-input md-border-radius-sm md-padding-xs" aria-label="Select role for <%= u.name %>">
                                                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                                            </select>
                                            <button type="submit" class="md-button md-button--contained md-ripple md-padding-sm md-border-radius-sm"
                                                <%= user.id === u.id && u.role === 'admin' ? 'title="Cannot demote yourself"' : '' %>>
                                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                                                Save
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
