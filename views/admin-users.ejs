<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Users - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>

            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
            </button>

            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/admin/users" role="menuitem" aria-current="page">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            User Management
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <section class="md-section md-padding-top-lg md-padding-bottom-md" aria-labelledby="admin-users-heading">
                <h1 id="admin-users-heading" class="md-headline-medium md-text-primary md-margin-bottom-xs">
                    <i class="bi bi-people md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                    User Management
                </h1>
                <p class="md-body-medium md-text-secondary md-margin-0">
                    View all registered users and manage their roles.
                </p>
            </section>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="users-table-heading">
                <h2 id="users-table-heading" class="md-visually-hidden">Users list</h2>

                <% if (!users || users.length === 0) { %>
                    <div class="md-row md-justify-center">
                        <div class="md-col-12 md-col-md-8">
                            <div class="md-card md-elevation-1 md-text-center md-padding-xl">
                                <div style="margin-bottom:1rem;">
                                    <i class="bi bi-people" aria-hidden="true" style="font-size:3rem;color:var(--primary,#FF6B00);"></i>
                                </div>
                                <h3 class="md-headline-small md-text-primary md-margin-bottom-sm">
                                    No users found
                                </h3>
                                <p class="md-body-medium md-text-secondary md-margin-0">
                                    No registered users in the system yet.
                                </p>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="md-card md-elevation-1">
                        <div class="md-card-content" style="overflow-x: auto;">
                            <table style="width: 100%; border-collapse: collapse;" aria-label="Users table">
                                <thead>
                                    <tr style="border-bottom: 2px solid var(--primary, #FF6B00);">
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">ID</th>
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">Name</th>
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">Email</th>
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">Role</th>
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">Joined</th>
                                        <th class="md-body-medium md-text-secondary" style="padding: 0.75rem; text-align: left;">Change Role</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(function(u) {
                                        var roleChipClass = 'md-chip';
                                        if (u.role === 'admin') { roleChipClass += ' md-chip-active'; }
                                        else if (u.role === 'driver') { roleChipClass += ' md-chip-pending'; }
                                        var joinedLabel = u.created_at ? new Date(u.created_at).toLocaleDateString() : '—';
                                    %>
                                    <tr style="border-bottom: 1px solid rgba(0, 0, 0, 0.08);">
                                        <td class="md-body-medium" style="padding: 0.75rem;"><%= u.id %></td>
                                        <td class="md-body-medium" style="padding: 0.75rem;"><%= u.name %></td>
                                        <td class="md-body-medium" style="padding: 0.75rem;"><%= u.email %></td>
                                        <td class="md-body-medium" style="padding: 0.75rem;">
                                            <span class="<%= roleChipClass %>">
                                                <i class="bi bi-circle-fill" aria-hidden="true" style="font-size: 0.5rem; margin-right: 0.35rem;"></i>
                                                <%= u.role %>
                                            </span>
                                        </td>
                                        <td class="md-body-medium" style="padding: 0.75rem;"><%= joinedLabel %></td>
                                        <td style="padding: 0.75rem;">
                                            <form action="/admin/users/<%= u.id %>/role" method="POST" style="display: flex; gap: 0.5rem; align-items: center;">
                                                <select name="role" aria-label="Select new role for <%= u.email %>">
                                                    <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>customer</option>
                                                    <option value="driver"   <%= u.role === 'driver'   ? 'selected' : '' %>>driver</option>
                                                    <option value="admin"    <%= u.role === 'admin'    ? 'selected' : '' %>>admin</option>
                                                </select>
                                                <button type="submit" class="md-button md-button--contained md-ripple" style="padding: 0.25rem 0.75rem;">
                                                    Save
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </section>
        </div>
    </main>

    <script src="/js/theme-toggle.js"></script>
    <script>
        (function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
            }
        })();
    </script>
</body>
</html>
