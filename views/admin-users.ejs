<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Manage Users - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="md-body">
    <main class="md-main" role="main">
        <div class="md-container md-padding-top-lg md-padding-bottom-lg">
            <div class="md-row md-justify-between md-align-center md-margin-bottom-lg">
                <h1 class="md-headline-medium md-text-primary">
                    <i class="bi bi-people-fill md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                    Manage Users
                </h1>
                <div class="md-display-flex md-gap-sm">
                    <a href="/admin/orders" class="md-button md-button--outlined md-ripple md-padding-sm md-border-radius-sm">
                        <i class="bi bi-clipboard-data md-icon-small md-margin-right-xs" aria-hidden="true"></i>
                        Manage Orders
                    </a>
                    <a href="/dashboard" class="md-button md-button--outlined md-ripple md-padding-sm md-border-radius-sm">
                        <i class="bi bi-house-fill md-icon-small md-margin-right-xs" aria-hidden="true"></i>
                        Dashboard
                    </a>
                </div>
            </div>

            <% if (typeof query !== 'undefined' && query && query.success) { %>
                <div class="md-card md-elevation-1 md-padding-md md-margin-bottom-md" style="border-left:4px solid #4CAF50;">
                    <i class="bi bi-check-circle-fill" aria-hidden="true" style="color:#4CAF50;"></i>
                    <span class="md-body-medium md-margin-left-xs">Role updated successfully.</span>
                </div>
            <% } %>

            <% if (typeof query !== 'undefined' && query && query.error) { %>
                <div class="md-card md-elevation-1 md-padding-md md-margin-bottom-md" style="border-left:4px solid #F44336;">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true" style="color:#F44336;"></i>
                    <span class="md-body-medium md-margin-left-xs">Failed to update role. Please try again.</span>
                </div>
            <% } %>

            <% if (users.length === 0) { %>
                <div class="md-card md-elevation-1 md-padding-xl md-text-center">
                    <i class="bi bi-people" aria-hidden="true" style="font-size:2rem;color:var(--primary,#FF6B00);"></i>
                    <p class="md-body-medium md-text-secondary md-margin-top-sm">No users found.</p>
                </div>
            <% } else { %>
                <div class="md-card md-elevation-1">
                    <table class="md-table" style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th class="md-table-header">ID</th>
                                <th class="md-table-header">Name</th>
                                <th class="md-table-header">Email</th>
                                <th class="md-table-header">Current Role</th>
                                <th class="md-table-header">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(u) { %>
                                <tr class="md-table-row">
                                    <td class="md-table-cell"><%= u.id %></td>
                                    <td class="md-table-cell"><%= u.name %></td>
                                    <td class="md-table-cell"><%= u.email %></td>
                                    <td class="md-table-cell">
                                        <span class="md-badge"><%= u.role %></span>
                                        <% if (u.id === user.id) { %>
                                            <span class="md-badge" style="background:var(--primary,#FF6B00);color:#fff;margin-left:0.25rem;" title="This is your own account">
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> You
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="md-table-cell">
                                        <form action="/admin/users/<%= u.id %>/role" method="POST" style="display:flex;align-items:center;gap:0.5rem;">
                                            <select name="role" class="md-select" aria-label="Select role for <%= u.name %>">
                                                <option value="admin"<% if (u.role === 'admin') { %> selected<% } %>>admin</option>
                                                <option value="user"<% if (u.role === 'user') { %> selected<% } %>>user</option>
                                            </select>
                                            <button type="submit" class="md-button md-button--contained md-ripple md-padding-sm md-border-radius-sm">
                                                Update
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
