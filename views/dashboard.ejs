<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>

    <!-- Top Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>

            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
            </button>

            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/dashboard" role="menuitem" aria-current="page">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders" role="menuitem">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            My Orders
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders/new" role="menuitem">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            New Order
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/profile" role="menuitem">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            Profile
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" class="md-navbar-form">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" id="main-content" role="main">
        <div class="md-container">
            <!-- Welcome Banner -->
            <section class="md-section md-padding-top-lg md-padding-bottom-md" aria-labelledby="dashboard-heading">
                <div class="md-dashboard-welcome" role="banner">
                    <div class="md-dashboard-welcome-row">
                        <i class="bi bi-truck md-dashboard-welcome-icon" aria-hidden="true"></i>
                        <div>
                            <h1 id="dashboard-heading" class="md-dashboard-welcome-title">
                                Welcome back, <%= user.name || user.username || 'Rider' %>
                            </h1>
                            <p class="md-dashboard-welcome-subtitle">
                                Here's what's happening with your deliveries today.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Stat cards -->
            <section class="md-section md-margin-bottom-lg" aria-labelledby="stats-heading">
                <h2 id="stats-heading" class="md-page-header-title md-margin-bottom-md">
                    <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
                    Delivery Overview
                </h2>
                <div class="md-stat-grid" data-testid="stats-row">
                    <article class="md-stat-card" aria-label="Active Deliveries">
                        <div class="md-stat-card-icon" aria-hidden="true">
                            <i class="bi bi-truck"></i>
                        </div>
                        <p class="md-stat-card-value"><%= typeof activeDeliveriesCount !== 'undefined' ? activeDeliveriesCount : 0 %></p>
                        <p class="md-stat-card-label">Active Deliveries</p>
                    </article>

                    <article class="md-stat-card" aria-label="Packages Delivered">
                        <div class="md-stat-card-icon md-stat-card-icon--accent" aria-hidden="true">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <p class="md-stat-card-value"><%= typeof deliveredCount !== 'undefined' ? deliveredCount : 0 %></p>
                        <p class="md-stat-card-label">Packages Delivered</p>
                    </article>

                    <article class="md-stat-card" aria-label="Pending Pickups">
                        <div class="md-stat-card-icon md-stat-card-icon--success" aria-hidden="true">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <p class="md-stat-card-value"><%= typeof pendingPickupsCount !== 'undefined' ? pendingPickupsCount : 0 %></p>
                        <p class="md-stat-card-label">Pending Pickups</p>
                    </article>

                    <article class="md-stat-card" aria-label="Days as member">
                        <div class="md-stat-card-icon md-stat-card-icon--info" aria-hidden="true">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>
                        <%
                            var memberDays = 0;
                            try {
                                var createdMs = new Date(user.created_at).getTime();
                                if (!isNaN(createdMs)) {
                                    memberDays = Math.max(0, Math.floor((Date.now() - createdMs) / (1000 * 60 * 60 * 24)));
                                }
                            } catch (e) { memberDays = 0; }
                        %>
                        <p class="md-stat-card-value"><%= memberDays %></p>
                        <p class="md-stat-card-label">Days as Member</p>
                    </article>
                </div>
            </section>

            <!-- Quick actions + Profile info -->
            <section class="md-section md-margin-bottom-lg" aria-labelledby="content-heading">
                <h2 id="content-heading" class="md-visually-hidden">Profile and quick actions</h2>
                <div class="md-row md-gutter-md">
                    <div class="md-col-12 md-col-md-6">
                        <div class="md-section-card" role="region" aria-labelledby="profile-info-heading">
                            <h3 id="profile-info-heading" class="md-section-card-title">
                                <i class="bi bi-person-fill" aria-hidden="true"></i>
                                Profile Information
                            </h3>
                            <p class="md-section-card-subtitle">Your Delivvr account at a glance.</p>
                            <div class="md-profile-info-list">
                                <div class="md-profile-info-item md-margin-bottom-sm">
                                    <div class="md-profile-info-label">
                                        <i class="bi bi-person md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                        <span class="md-body2">Name</span>
                                    </div>
                                    <div class="md-profile-info-value md-padding-left-lg">
                                        <span class="md-body1"><%= user.name %></span>
                                    </div>
                                </div>
                                <div class="md-profile-info-item md-margin-bottom-sm">
                                    <div class="md-profile-info-label">
                                        <i class="bi bi-envelope md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                        <span class="md-body2">Email</span>
                                    </div>
                                    <div class="md-profile-info-value md-padding-left-lg">
                                        <span class="md-body1"><%= user.email %></span>
                                    </div>
                                </div>
                                <div class="md-profile-info-item">
                                    <div class="md-profile-info-label">
                                        <i class="bi bi-calendar-date md-text-primary md-margin-right-sm" aria-hidden="true"></i>
                                        <span class="md-body2">Member Since</span>
                                    </div>
                                    <div class="md-profile-info-value md-padding-left-lg">
                                        <span class="md-body1"><%= new Date(user.created_at).toLocaleDateString() %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="md-col-12 md-col-md-6">
                        <div class="md-section-card" role="region" aria-labelledby="quick-actions-heading">
                            <h3 id="quick-actions-heading" class="md-section-card-title">
                                <i class="bi bi-lightning-fill" aria-hidden="true"></i>
                                Quick Actions
                            </h3>
                            <p class="md-section-card-subtitle">Common things you can do right now.</p>
                            <div class="md-button-group md-vertical md-gap-md">
                                <a href="/orders/new" class="md-btn md-button md-btn-primary md-button--contained" role="button">
                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                    <span>Place Order</span>
                                </a>
                                <a href="/orders" class="md-btn md-button md-button--outlined" role="button">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                    <span>My Orders</span>
                                </a>
                                <a href="/profile" class="md-btn md-button md-button--outlined" role="button">
                                    <i class="bi bi-person-gear" aria-hidden="true"></i>
                                    <span>Edit Profile</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <footer class="md-footer" role="contentinfo">
        <div class="md-container">
            <p class="md-body2 md-text-secondary md-text-center md-margin-none">&copy; 2026 Delivvr. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/theme-toggle.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && navMenu.classList.contains('show')) {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('show');
                    }
                });
            }
        });
    </script>
</body>
</html>
