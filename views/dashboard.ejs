<!-- Welcome Message -->
<div class="alert alert-success mb-4" role="alert">
    <h4 class="alert-heading">
        <i class="bi bi-house-heart me-2"></i>Welcome back, <%= user.name %>!
    </h4>
    <p class="mb-0">You have successfully accessed your dashboard. Manage your account and explore your options below.</p>
</div>

<!-- User Profile Information Card -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="bi bi-person-circle me-2"></i>Profile Information
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold text-muted">Name:</td>
                        <td><%= user.name %></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-muted">Email:</td>
                        <td><%= user.email %></td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold text-muted">User ID:</td>
                        <td><%= user.id %></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-muted">Member Since:</td>
                        <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="bi bi-lightning me-2"></i>Quick Actions
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary" type="button">
                        <i class="bi bi-pencil me-2"></i>Edit Profile
                    </button>
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="bi bi-shield-lock me-2"></i>Change Password
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-info" type="button">
                        <i class="bi bi-gear me-2"></i>Account Settings
                    </button>
                    <button class="btn btn-outline-warning" type="button">
                        <i class="bi bi-bell me-2"></i>Notifications
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Session Information -->
<div class="card shadow">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="bi bi-clock-history me-2"></i>Session Information
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-2">
                    <span class="fw-bold text-muted">Login Time:</span><br>
                    <small class="text-muted"><%= new Date().toLocaleString() %></small>
                </p>
            </div>
            <div class="col-md-6">
                <p class="mb-2">
                    <span class="fw-bold text-muted">Session Status:</span><br>
                    <small><span class="badge bg-success">Active</span></small>
                </p>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <p class="mb-0">
                    <span class="fw-bold text-muted">Account Type:</span><br>
                    <small class="text-muted">Standard User</small>
                </p>
            </div>
            <div class="col-md-6">
                <p class="mb-0">
                    <span class="fw-bold text-muted">Last Activity:</span><br>
                    <small class="text-muted">Just now</small>
                </p>
            </div>
        </div>
    </div>
</div>