<%- include('layout', { title: 'Dashboard', currentPage: 'dashboard' }) %>

<!-- Dashboard Content -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
        </div>

        <!-- Welcome Message -->
        <div class="alert alert-success" role="alert">
            <h4 class="alert-heading">Welcome to your dashboard!</h4>
            <p class="mb-0">You have successfully logged in to the Express Auth application.</p>
        </div>

        <!-- User Profile Information -->
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Profile Information</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Name:</strong></td>
                                <td><%= user.name %></td>
                            </tr>
                            <tr>
                                <td><strong>Email:</strong></td>
                                <td><%= user.email %></td>
                            </tr>
                            <tr>
                                <td><strong>User ID:</strong></td>
                                <td><%= user.id %></td>
                            </tr>
                            <tr>
                                <td><strong>Member Since:</strong></td>
                                <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning-charge me-2"></i>Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" type="button">
                                <i class="bi bi-pencil-square me-2"></i>Edit Profile
                            </button>
                            <button class="btn btn-outline-secondary" type="button">
                                <i class="bi bi-key me-2"></i>Change Password
                            </button>
                            <button class="btn btn-outline-info" type="button">
                                <i class="bi bi-gear me-2"></i>Account Settings
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Session Info -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Session Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">
                                    <strong>Login Time:</strong> <%= new Date().toLocaleString() %>
                                </small>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">
                                    <strong>Session Status:</strong> <span class="text-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Back -->
        <div class="mt-4 text-center">
            <a href="/" class="btn btn-secondary">
                <i class="bi bi-house me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>

<!-- Mobile Offcanvas Sidebar -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">
            <i class="bi bi-shield-lock me-2"></i>Auth App
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <nav class="nav flex-column">
            <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>" href="/dashboard">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a class="nav-link <%= currentPage === 'profile' ? 'active' : '' %>" href="/profile">
                <i class="bi bi-person-circle me-2"></i>Profile
            </a>
            <a class="nav-link <%= currentPage === 'settings' ? 'active' : '' %>" href="/settings">
                <i class="bi bi-gear me-2"></i>Settings
            </a>
            <hr>
            <form action="/logout" method="POST" class="d-inline">
                <button type="submit" class="nav-link text-start border-0 bg-transparent w-100">
                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                </button>
            </form>
        </nav>
    </div>
</div>