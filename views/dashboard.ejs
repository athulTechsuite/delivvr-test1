<%- include('layout', { 
    title: 'Dashboard',
    bodyClass: 'dashboard-page',
    user: user
}) %>

<div class="container-fluid">
    <div class="row">
        <!-- Main content -->
        <main class="col-12 col-lg-10 offset-lg-2 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
                <h1 class="h2 text-white">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <button type="button" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-share"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-printer"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Welcome Message Card -->
            <div class="card shadow-sm mb-4" style="background-color: #34495e; border: none;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle p-3 me-3">
                            <i class="bi bi-speedometer2 text-white fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="text-white mb-1">Welcome back, <%- user.name %>!</h4>
                            <p class="text-light mb-0">You have successfully logged in to your dashboard.</p>
                        </div>
                        <!-- Avatar Section -->
                        <div class="flex-shrink-0">
                            <div class="position-relative">
                                <% if (user.avatar_url) { %>
                                    <img src="<%- user.avatar_url %>" alt="Profile Avatar" 
                                         class="rounded-circle" width="60" height="60"
                                         style="object-fit: cover; border: 3px solid #fff;">
                                <% } else { %>
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 60px; height: 60px; border: 3px solid #fff;">
                                        <i class="bi bi-person-fill text-white fs-5"></i>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Profile Information Card -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="card shadow-sm h-100" style="background-color: #2c3e50; border: none;">
                        <div class="card-header" style="background-color: #34495e; border-bottom: 1px solid #495057;">
                            <h5 class="mb-0 text-white">
                                <i class="bi bi-person-circle me-2"></i>Profile Information
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-person text-primary me-2"></i>
                                        <small class="text-light">Name</small>
                                    </div>
                                    <p class="text-white mb-0 fs-6 fw-medium"><%- user.name %></p>
                                </div>
                                
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-envelope text-primary me-2"></i>
                                        <small class="text-light">Email</small>
                                    </div>
                                    <p class="text-white mb-0 fs-6 fw-medium"><%- user.email %></p>
                                </div>
                                
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-telephone text-primary me-2"></i>
                                        <small class="text-light">Phone</small>
                                    </div>
                                    <p class="text-white mb-0 fs-6 fw-medium"><%- user.phone || 'Not provided' %></p>
                                </div>
                                
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-hash text-primary me-2"></i>
                                        <small class="text-light">User ID</small>
                                    </div>
                                    <p class="text-white mb-0 fs-6 fw-medium">#<%- user.id %></p>
                                </div>
                                
                                <div class="col-12">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-calendar text-primary me-2"></i>
                                        <small class="text-light">Member Since</small>
                                    </div>
                                    <p class="text-white mb-0 fs-6 fw-medium"><%- new Date(user.created_at).toLocaleDateString() %></p>
                                </div>
                            </div>
                            
                            <% if (user.bio) { %>
                            <hr class="border-secondary my-3">
                            <div class="mb-2">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-info-circle text-primary me-2"></i>
                                    <small class="text-light">Bio</small>
                                </div>
                                <p class="text-white mb-0 fs-6"><%- user.bio %></p>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Actions Card -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="card shadow-sm h-100" style="background-color: #2c3e50; border: none;">
                        <div class="card-header" style="background-color: #34495e; border-bottom: 1px solid #495057;">
                            <h5 class="mb-0 text-white">
                                <i class="bi bi-lightning-charge me-2"></i>Quick Actions
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-grid gap-3">
                                <a href="/dashboard/profile" 
                                   class="btn btn-primary btn-lg d-flex align-items-center justify-content-start">
                                    <i class="bi bi-person-gear me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-semibold">Edit Profile</div>
                                        <small class="opacity-75">Update your personal information</small>
                                    </div>
                                </a>
                                
                                <button class="btn btn-outline-light btn-lg d-flex align-items-center justify-content-start" 
                                        type="button" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#changePasswordModal">
                                    <i class="bi bi-key me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-semibold">Change Password</div>
                                        <small class="opacity-75">Update your account password</small>
                                    </div>
                                </button>
                                
                                <button class="btn btn-outline-light btn-lg d-flex align-items-center justify-content-start" 
                                        type="button"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#avatarUploadModal">
                                    <i class="bi bi-image me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-semibold">Upload Avatar</div>
                                        <small class="opacity-75">Change your profile picture</small>
                                    </div>
                                </button>
                                
                                <button class="btn btn-outline-light btn-lg d-flex align-items-center justify-content-start" 
                                        type="button"
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#accountSettings" 
                                        aria-expanded="false" 
                                        aria-controls="accountSettings">
                                    <i class="bi bi-gear me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-semibold">Account Settings</div>
                                        <small class="opacity-75">Manage your account preferences</small>
                                    </div>
                                </button>
                            </div>
                            
                            <!-- Collapsible Account Settings -->
                            <div class="collapse mt-3" id="accountSettings">
                                <div class="card card-body bg-dark border-secondary">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <button class="btn btn-sm btn-outline-warning w-100">
                                                <i class="bi bi-bell me-2"></i>Notification Settings
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <button class="btn btn-sm btn-outline-info w-100">
                                                <i class="bi bi-shield-check me-2"></i>Privacy Settings
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <button class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-trash me-2"></i>Delete Account
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Session Information Card -->
            <div class="card shadow-sm mb-4" style="background-color: #2c3e50; border: none;">
                <div class="card-header" style="background-color: #34495e; border-bottom: 1px solid #495057;">
                    <h5 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-2"></i>Session Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3 mb-md-0">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clock text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-light d-block">Current Time</small>
                                    <span class="text-white fw-medium"><%- new Date().toLocaleString() %></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-shield-check text-success me-3 fs-5"></i>
                                <div>
                                    <small class="text-light d-block">Session Status</small>
                                    <span class="badge bg-success px-3 py-2">Active & Secure</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Actions -->
            <div class="text-center mb-4">
                <div class="btn-group" role="group" aria-label="Navigation actions">
                    <a href="/" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-house me-2"></i>Back to Home
                    </a>
                    <form action="/auth/logout" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-lg">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="changePasswordModalLabel">
                    <i class="bi bi-key me-2"></i>Change Password
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm" method="POST" action="/dashboard/change-password">
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <input type="password" class="form-control bg-dark text-light border-secondary" 
                               id="currentPassword" name="currentPassword" required>
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control bg-dark text-light border-secondary" 
                               id="newPassword" name="newPassword" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control bg-dark text-light border-secondary" 
                               id="confirmPassword" name="confirmPassword" required minlength="6">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="changePasswordForm" class="btn btn-primary">Update Password</button>
            </div>
        </div>
    </div>
</div>

<!-- Avatar Upload Modal -->
<div class="modal fade" id="avatarUploadModal" tabindex="-1" aria-labelledby="avatarUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="avatarUploadModalLabel">
                    <i class="bi bi-image me-2"></i>Upload Avatar
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="avatarUploadForm" method="POST" action="/dashboard/upload-avatar" enctype="multipart/form-data">
                    <div class="text-center mb-4">
                        <% if (user.avatar_url) { %>
                            <img src="<%- user.avatar_url %>" alt="Current Avatar" 
                                 class="rounded-circle mb-3" width="100" height="100"
                                 style="object-fit: cover; border: 3px solid #fff;">
                        <% } else { %>
                            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" 
                                 style="width: 100px; height: 100px; border: 3px solid #fff;">
                                <i class="bi bi-person-fill text-white fs-1"></i>
                            </div>
                        <% } %>
                        <p class="text-muted">Current Profile Picture</p>
                    </div>
                    <div class="mb-3">
                        <label for="avatar" class="form-label">Choose New Avatar</label>
                        <input type="file" class="form-control bg-dark text-light border-secondary" 
                               id="avatar" name="avatar" accept="image/*" required>
                        <div class="form-text text-muted">
                            Supported formats: JPG, PNG, GIF. Max size: 2MB.
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="removeAvatar" name="removeAvatar">
                            <label class="form-check-label" for="removeAvatar">
                                Remove current avatar instead
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="avatarUploadForm" class="btn btn-primary">
                    <i class="bi bi-cloud-upload me-2"></i>Upload Avatar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast notifications for user feedback -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i>
                Operation completed successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="errorMessage">An error occurred!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
// XSS Prevention - Sanitize any dynamic content
document.addEventListener('DOMContentLoaded', function() {
    // Form validation and submission handling
    const changePasswordForm = document.getElementById('changePasswordForm');
    if (changePasswordForm) {
        changePasswordForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            
            // Client-side validation
            const newPassword = formData.get('newPassword');
            const confirmPassword = formData.get('confirmPassword');
            
            if (newPassword !== confirmPassword) {
                showErrorToast('Passwords do not match!');
                return;
            }
            
            // Submit form via fetch with CSRF protection
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessToast('Password updated successfully!');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                    this.reset();
                } else {
                    showErrorToast(data.error || 'Failed to update password');
                }
            })
            .catch(error => {
                showErrorToast('Network error occurred');
            });
        });
    }

    // Avatar upload handling
    const avatarUploadForm = document.getElementById('avatarUploadForm');
    if (avatarUploadForm) {
        avatarUploadForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessToast('Avatar updated successfully!');
                    bootstrap.Modal.getInstance(document.getElementById('avatarUploadModal')).hide();
                    // Reload page to show updated avatar
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showErrorToast(data.error || 'Failed to update avatar');
                }
            })
            .catch(error => {
                showErrorToast('Network error occurred');
            });
        });
    }

    // Toast notification functions
    function showSuccessToast(message) {
        const toast = document.getElementById('successToast');
        const toastBody = toast.querySelector('.toast-body');
        toastBody.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i>${escapeHtml(message)}`;
        new bootstrap.Toast(toast).show();
    }

    function showErrorToast(message) {
        const toast = document.getElementById('errorToast');
        const messageSpan = toast.querySelector('#errorMessage');
        messageSpan.textContent = message;
        new bootstrap.Toast(toast).show();
    }

    // XSS Prevention - HTML escaping function
    function escapeHtml(unsafe) {
        return unsafe
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    // Mobile responsive handling
    function handleMobileLayout() {
        const isMobile = window.innerWidth < 768;
        const cards = document.querySelectorAll('.card');
        
        cards.forEach(card => {
            if (isMobile) {
                card.classList.add('mb-3');
                card.classList.remove('mb-4');
            } else {
                card.classList.add('mb-4');
                card.classList.remove('mb-3');
            }
        });
    }

    // Handle window resize
    window.addEventListener('resize', handleMobileLayout);
    handleMobileLayout();

    // Show success message if present in URL
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success')) {
        showSuccessToast('Profile updated successfully!');
        // Clean URL
        window.history.replaceState({}, document.title, window.location.pathname);
    }
});
</script>

<%- include('partials/footer') %>