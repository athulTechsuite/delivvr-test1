<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Express Auth App</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,0,1;wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link" aria-label="Express Auth App Home">
                    <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                    <span>Express Auth</span>
                </a>
            </div>
            
            <!-- Mobile Menu Toggle -->
            <button class="md-navbar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
            </button>
            
            <!-- Navigation Links -->
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/" role="menuitem">
                            <i class="bi bi-house" aria-hidden="true"></i>
                            Home
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/login" role="menuitem">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            Login
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link active" href="/signup" role="menuitem" aria-current="page">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            Sign Up
                        </a>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-item" role="none">
                        <div class="md-theme-toggle" role="menuitem" aria-label="Toggle theme" tabindex="0">
                            <div class="md-theme-toggle-track">
                                <div class="md-theme-toggle-thumb">
                                    <i class="bi bi-sun-fill md-theme-icon-light" aria-hidden="true"></i>
                                    <i class="bi bi-moon-fill md-theme-icon-dark" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <!-- Signup Form Section -->
            <section class="md-section" aria-labelledby="signup-heading">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8 md-col-lg-6 md-col-xl-5">
                        <!-- Signup Card -->
                        <div class="md-card md-elevation-2" role="form" aria-labelledby="signup-heading">
                            <!-- Card Header -->
                            <div class="md-card-header">
                                <h1 id="signup-heading" class="md-headline-medium md-text-primary md-text-center">
                                    <i class="bi bi-person-plus-fill md-icon-medium" aria-hidden="true"></i>
                                    Create Account
                                </h1>
                                <p class="md-body-medium md-text-secondary md-text-center md-margin-top-sm">
                                    Join our platform today and start exploring
                                </p>
                            </div>

                            <!-- Card Content -->
                            <div class="md-card-content">
                                <!-- Error Alert -->
                                <% if (typeof error !== 'undefined' && error) { %>
                                    <div class="md-alert md-alert-error md-margin-bottom-lg" role="alert" aria-live="polite">
                                        <div class="md-alert-icon">
                                            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-alert-content">
                                            <p class="md-alert-message"><%= error %></p>
                                        </div>
                                    </div>
                                <% } %>
                                
                                <!-- Success Alert -->
                                <% if (typeof success !== 'undefined' && success) { %>
                                    <div class="md-alert md-alert-success md-margin-bottom-lg" role="alert" aria-live="polite">
                                        <div class="md-alert-icon">
                                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-alert-content">
                                            <p class="md-alert-message"><%= success %></p>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Signup Form -->
                                <form id="signupForm" action="/signup" method="POST" novalidate>
                                    <!-- Full Name Field -->
                                    <div class="md-form-field md-margin-bottom-lg">
                                        <div class="md-input-container">
                                            <input 
                                                type="text" 
                                                id="name" 
                                                name="name" 
                                                class="md-input" 
                                                required 
                                                minlength="2"
                                                maxlength="50"
                                                pattern="[a-zA-Z\s]+"
                                                autocomplete="name"
                                                aria-describedby="name-helper"
                                            >
                                            <label for="name" class="md-label">
                                                <i class="bi bi-person" aria-hidden="true"></i>
                                                Full Name
                                            </label>
                                            <div class="md-input-underline"></div>
                                        </div>
                                        <div id="name-helper" class="md-helper-text">
                                            Enter your full name (letters and spaces only)
                                        </div>
                                        <div class="md-error-text" role="alert" aria-live="polite"></div>
                                    </div>

                                    <!-- Email Field -->
                                    <div class="md-form-field md-margin-bottom-lg">
                                        <div class="md-input-container">
                                            <input 
                                                type="email" 
                                                id="email" 
                                                name="email" 
                                                class="md-input" 
                                                required 
                                                autocomplete="email"
                                                aria-describedby="email-helper"
                                            >
                                            <label for="email" class="md-label">
                                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                                Email Address
                                            </label>
                                            <div class="md-input-underline"></div>
                                        </div>
                                        <div id="email-helper" class="md-helper-text">
                                            We'll use this email for account verification and notifications
                                        </div>
                                        <div class="md-error-text" role="alert" aria-live="polite"></div>
                                    </div>

                                    <!-- Password Field -->
                                    <div class="md-form-field md-margin-bottom-lg">
                                        <div class="md-input-container">
                                            <input 
                                                type="password" 
                                                id="password" 
                                                name="password" 
                                                class="md-input" 
                                                required 
                                                minlength="6"
                                                maxlength="128"
                                                autocomplete="new-password"
                                                aria-describedby="password-helper password-requirements"
                                            >
                                            <label for="password" class="md-label">
                                                <i class="bi bi-lock" aria-hidden="true"></i>
                                                Password
                                            </label>
                                            <button 
                                                type="button" 
                                                class="md-input-action" 
                                                id="togglePassword"
                                                aria-label="Show password"
                                                tabindex="-1"
                                            >
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                            <div class="md-input-underline"></div>
                                        </div>
                                        <div id="password-helper" class="md-helper-text">
                                            Password must be at least 6 characters long
                                        </div>
                                        <div id="password-requirements" class="md-helper-text md-text-caption">
                                            Must contain: lowercase letter, uppercase letter, and number
                                        </div>
                                        <div class="md-error-text" role="alert" aria-live="polite"></div>
                                    </div>

                                    <!-- Confirm Password Field -->
                                    <div class="md-form-field md-margin-bottom-xl">
                                        <div class="md-input-container">
                                            <input 
                                                type="password" 
                                                id="confirmPassword" 
                                                name="confirmPassword" 
                                                class="md-input" 
                                                required 
                                                autocomplete="new-password"
                                                aria-describedby="confirm-password-helper"
                                            >
                                            <label for="confirmPassword" class="md-label">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                                Confirm Password
                                            </label>
                                            <button 
                                                type="button" 
                                                class="md-input-action" 
                                                id="toggleConfirmPassword"
                                                aria-label="Show confirm password"
                                                tabindex="-1"
                                            >
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                            <div class="md-input-underline"></div>
                                        </div>
                                        <div id="confirm-password-helper" class="md-helper-text">
                                            Re-enter your password to confirm
                                        </div>
                                        <div class="md-error-text" role="alert" aria-live="polite"></div>
                                    </div>

                                    <!-- Submit Button -->
                                    <div class="md-form-field">
                                        <button 
                                            type="submit" 
                                            class="md-button md-button-primary md-button-elevated md-width-full"
                                            id="submitButton"
                                        >
                                            <span class="md-button-label">
                                                <i class="bi bi-person-plus" aria-hidden="true"></i>
                                                Create Account
                                            </span>
                                            <div class="md-button-ripple"></div>
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <!-- Card Footer -->
                            <div class="md-card-actions">
                                <div class="md-text-center">
                                    <p class="md-body-medium md-text-secondary">
                                        Already have an account? 
                                        <a href="/login" class="md-link md-link-primary">
                                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                            Sign in here
                                        </a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- JavaScript for Form Validation and Interactions -->
    <script>
        // Constants for validation
        const VALIDATION_PATTERNS = {
            name: /^[a-zA-Z\s]+$/,
            password: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/
        };

        const MIN_NAME_LENGTH = 2;
        const MAX_NAME_LENGTH = 50;
        const MIN_PASSWORD_LENGTH = 6;
        const MAX_PASSWORD_LENGTH = 128;

        // Form elements
        const form = document.getElementById('signupForm');
        const nameField = document.getElementById('name');
        const emailField = document.getElementById('email');
        const passwordField = document.getElementById('password');
        const confirmPasswordField = document.getElementById('confirmPassword');
        const submitButton = document.getElementById('submitButton');
        const togglePasswordButton = document.getElementById('togglePassword');
        const toggleConfirmPasswordButton = document.getElementById('toggleConfirmPassword');

        // Validation state
        const fieldValidation = {
            name: false,
            email: false,
            password: false,
            confirmPassword: false
        };

        // Utility functions
        function showFieldError(field, message) {
            const container = field.closest('.md-form-field');
            const errorElement = container.querySelector('.md-error-text');
            const inputContainer = container.querySelector('.md-input-container');
            
            errorElement.textContent = message;
            inputContainer.classList.add('md-input-error');
            field.setAttribute('aria-invalid', 'true');
        }

        function clearFieldError(field) {
            const container = field.closest('.md-form-field');
            const errorElement = container.querySelector('.md-error-text');
            const inputContainer = container.querySelector('.md-input-container');
            
            errorElement.textContent = '';
            inputContainer.classList.remove('md-input-error');
            field.setAttribute('aria-invalid', 'false');
        }

        function showFieldSuccess(field) {
            const container = field.closest('.md-form-field');
            const inputContainer = container.querySelector('.md-input-container');
            
            inputContainer.classList.add('md-input-success');
        }

        function clearFieldSuccess(field) {
            const container = field.closest('.md-form-field');
            const inputContainer = container.querySelector('.md-input-container');
            
            inputContainer.classList.remove('md-input-success');
        }

        function updateSubmitButton() {
            const allValid = Object.values(fieldValidation).every(valid => valid);
            submitButton.disabled = !allValid;
            
            if (allValid) {
                submitButton.classList.remove('md-button-disabled');
            } else {
                submitButton.classList.add('md-button-disabled');
            }
        }

        // Validation functions
        function validateName() {
            const value = nameField.value.trim();
            
            if (!value) {
                showFieldError(nameField, 'Full name is required');
                fieldValidation.name = false;
                return false;
            }
            
            if (value.length < MIN_NAME_LENGTH || value.length > MAX_NAME_LENGTH) {
                showFieldError(nameField, `Name must be between ${MIN_NAME_LENGTH} and ${MAX_NAME_LENGTH} characters`);
                fieldValidation.name = false;
                return false;
            }
            
            if (!VALIDATION_PATTERNS.name.test(value)) {
                showFieldError(nameField, 'Name can only contain letters and spaces');
                fieldValidation.name = false;
                return false;
            }
            
            clearFieldError(nameField);
            showFieldSuccess(nameField);
            fieldValidation.name = true;
            return true;
        }

        function validateEmail() {
            const value = emailField.value.trim();
            
            if (!value) {
                showFieldError(emailField, 'Email address is required');
                fieldValidation.email = false;
                return false;
            }
            
            // Basic email validation
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(value)) {
                showFieldError(emailField, 'Please enter a valid email address');
                fieldValidation.email = false;
                return false;
            }
            
            clearFieldError(emailField);
            showFieldSuccess(emailField);
            fieldValidation.email = true;
            return true;
        }

        function validatePassword() {
            const value = passwordField.value;
            
            if (!value) {
                showFieldError(passwordField, 'Password is required');
                fieldValidation.password = false;
                return false;
            }
            
            if (value.length < MIN_PASSWORD_LENGTH || value.length > MAX_PASSWORD_LENGTH) {
                showFieldError(passwordField, `Password must be between ${MIN_PASSWORD_LENGTH} and ${MAX_PASSWORD_LENGTH} characters`);
                fieldValidation.password = false;
                return false;
            }
            
            if (!VALIDATION_PATTERNS.password.test(value)) {
                showFieldError(passwordField, 'Password must contain at least one lowercase letter, one uppercase letter, and one number');
                fieldValidation.password = false;
                return false;
            }
            
            clearFieldError(passwordField);
            showFieldSuccess(passwordField);
            fieldValidation.password = true;
            
            // Re-validate confirm password if it has a value
            if (confirmPasswordField.value) {
                validateConfirmPassword();
            }
            
            return true;
        }

        function validateConfirmPassword() {
            const value = confirmPasswordField.value;
            const passwordValue = passwordField.value;
            
            if (!value) {
                showFieldError(confirmPasswordField, 'Please confirm your password');
                fieldValidation.confirmPassword = false;
                return false;
            }
            
            if (value !== passwordValue) {
                showFieldError(confirmPasswordField, 'Passwords do not match');
                fieldValidation.confirmPassword = false;
                return false;
            }
            
            clearFieldError(confirmPasswordField);
            showFieldSuccess(confirmPasswordField);
            fieldValidation.confirmPassword = true;
            return true;
        }

        // Password toggle functionality
        function togglePasswordVisibility(inputField, toggleButton) {
            const isPassword = inputField.type === 'password';
            const icon = toggleButton.querySelector('i');
            
            if (isPassword) {
                inputField.type = 'text';
                icon.className = 'bi bi-eye-slash';
                toggleButton.setAttribute('aria-label', 'Hide password');
            } else {
                inputField.type = 'password';
                icon.className = 'bi bi-eye';
                toggleButton.setAttribute('aria-label', 'Show password');
            }
        }

        // Event listeners
        nameField.addEventListener('blur', () => {
            validateName();
            updateSubmitButton();
        });

        nameField.addEventListener('input', () => {
            if (nameField.value.trim()) {
                clearFieldError(nameField);
                clearFieldSuccess(nameField);
            }
        });

        emailField.addEventListener('blur', () => {
            validateEmail();
            updateSubmitButton();
        });

        emailField.addEventListener('input', () => {
            if (emailField.value.trim()) {
                clearFieldError(emailField);
                clearFieldSuccess(emailField);
            }
        });

        passwordField.addEventListener('blur', () => {
            validatePassword();
            updateSubmitButton();
        });

        passwordField.addEventListener('input', () => {
            if (passwordField.value) {
                clearFieldError(passwordField);
                clearFieldSuccess(passwordField);
            }
        });

        confirmPasswordField.addEventListener('blur', () => {
            validateConfirmPassword();
            updateSubmitButton();
        });

        confirmPasswordField.addEventListener('input', () => {
            if (confirmPasswordField.value) {
                clearFieldError(confirmPasswordField);
                clearFieldSuccess(confirmPasswordField);
            }
        });

        togglePasswordButton.addEventListener('click', () => {
            togglePasswordVisibility(passwordField, togglePasswordButton);
        });

        toggleConfirmPasswordButton.addEventListener('click', () => {
            togglePasswordVisibility(confirmPasswordField, toggleConfirmPasswordButton);
        });

        // Form submission
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Clear all previous states
            [nameField, emailField, passwordField, confirmPasswordField].forEach(field => {
                clearFieldError(field);
                clearFieldSuccess(field);
            });
            
            // Validate all fields
            const nameValid = validateName();
            const emailValid = validateEmail();
            const passwordValid = validatePassword();
            const confirmPasswordValid = validateConfirmPassword();
            
            // Update submit button state
            updateSubmitButton();
            
            // If all validations pass, submit the form
            if (nameValid && emailValid && passwordValid && confirmPasswordValid) {
                // Show loading state
                submitButton.disabled = true;
                const buttonLabel = submitButton.querySelector('.md-button-label');
                const originalContent = buttonLabel.innerHTML;
                buttonLabel.innerHTML = '<i class="bi bi-hourglass-split" aria-hidden="true"></i> Creating Account...';
                
                // Submit form
                this.submit();
            } else {
                // Focus on first invalid field
                const invalidField = [nameField, emailField, passwordField, confirmPasswordField]
                    .find((field, index) => !Object.values(fieldValidation)[index]);
                
                if (invalidField) {
                    invalidField.focus();
                }
            }
        });

        // Initialize form state
        updateSubmitButton();

        // Add floating label behavior
        document.querySelectorAll('.md-input').forEach(input => {
            const container = input.closest('.md-input-container');
            const label = container.querySelector('.md-label');
            
            function updateLabelState() {
                if (input.value || input === document.activeElement) {
                    container.classList.add('md-input-focused');
                } else {
                    container.classList.remove('md-input-focused');
                }
            }
            
            input.addEventListener('focus', updateLabelState);
            input.addEventListener('blur', updateLabelState);
            input.addEventListener('input', updateLabelState);
            
            // Initialize state
            updateLabelState();
        });

        // Mobile navigation toggle functionality
        const navToggle = document.querySelector('.md-navbar-toggle');
        const navMenu = document.querySelector('.md-navbar-nav');
        
        if (navToggle && navMenu) {
            navToggle.addEventListener('click', function() {
                const expanded = this.getAttribute('aria-expanded') === 'true';
                this.setAttribute('aria-expanded', !expanded);
                navMenu.classList.toggle('md-navbar-nav-open');
                
                // Toggle icon
                const icon = this.querySelector('.md-navbar-toggle-icon');
                if (icon) {
                    icon.classList.toggle('md-navbar-toggle-active');
                }
            });
            
            // Close mobile menu when clicking outside
            document.addEventListener('click', function(e) {
                if (!navToggle.contains(e.target) && !navMenu.contains(e.target)) {
                    navToggle.setAttribute('aria-expanded', 'false');
                    navMenu.classList.remove('md-navbar-nav-open');
                    const icon = navToggle.querySelector('.md-navbar-toggle-icon');
                    if (icon) {
                        icon.classList.remove('md-navbar-toggle-active');
                    }
                }
            });
        }
    </script>
    <script src="/js/theme-toggle.js"></script>
</body>
</html>