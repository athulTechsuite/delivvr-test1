<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <a href="#signup-form" class="skip-link sr-only">Skip to signup form</a>
    <main class="md-auth-shell" role="main">
        <section class="md-auth-card" aria-labelledby="signup-heading">
            <header class="md-auth-brand">
                <div class="md-auth-brand-mark" aria-hidden="true">
                    <i class="bi bi-truck"></i>
                </div>
                <h1 id="signup-heading" class="md-auth-title">Create your Delivvr account</h1>
                <p class="md-auth-subtitle">Start delivering smarter in minutes</p>
            </header>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="md-alert md-alert--error md-alert-error md-margin-bottom-md" role="alert" aria-live="polite">
                    <div class="md-alert-content">
                        <i class="bi bi-exclamation-circle-fill md-alert-icon" aria-hidden="true"></i>
                        <span class="md-alert-message"><%= error %></span>
                    </div>
                </div>
            <% } %>

            <form id="signup-form" action="/signup" method="POST" class="md-form" novalidate aria-labelledby="signup-heading">
                <div class="md-form-field md-margin-bottom-md">
                    <div class="md-form-group">
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            minlength="2"
                            maxlength="50"
                            pattern="[a-zA-Z\s]+"
                            autocomplete="name"
                            aria-describedby="name-helper name-error"
                        >
                        <label class="md-form-label" for="name">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            Full Name
                        </label>
                    </div>
                    <div id="name-helper" class="md-form-helper-text">Letters and spaces only, 2&ndash;50 characters.</div>
                    <div id="name-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <div class="md-form-field md-margin-bottom-md">
                    <div class="md-form-group">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            autocomplete="email"
                            aria-describedby="email-helper email-error"
                        >
                        <label class="md-form-label" for="email">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            Email Address
                        </label>
                    </div>
                    <div id="email-helper" class="md-form-helper-text">We'll use this for login and order updates.</div>
                    <div id="email-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <div class="md-form-field md-margin-bottom-md">
                    <div class="md-form-group">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            minlength="6"
                            maxlength="128"
                            autocomplete="new-password"
                            aria-describedby="password-helper password-error"
                        >
                        <label class="md-form-label" for="password">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            Password
                        </label>
                        <button
                            type="button"
                            class="md-input-toggle-password"
                            aria-label="Show password"
                            tabindex="-1"
                            data-toggle="password"
                        >
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="password-helper" class="md-form-helper-text">At least 6 chars with one lowercase, one uppercase, one number.</div>
                    <div id="password-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <div class="md-form-field md-margin-bottom-lg">
                    <div class="md-form-group">
                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            class="md-form-control md-input"
                            placeholder=" "
                            required
                            autocomplete="new-password"
                            aria-describedby="confirm-password-error"
                        >
                        <label class="md-form-label" for="confirmPassword">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Confirm Password
                        </label>
                        <button
                            type="button"
                            class="md-input-toggle-password"
                            aria-label="Show password"
                            tabindex="-1"
                            data-toggle="confirmPassword"
                        >
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="confirm-password-error" class="md-form-helper-text md-form-error-text" role="alert" aria-live="polite"></div>
                </div>

                <button
                    type="submit"
                    class="md-btn md-button md-btn-primary md-button--contained md-btn-block md-button--full-width md-button--large"
                    id="submitButton"
                >
                    <span class="md-button-label">
                        <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                        Create Account
                    </span>
                </button>
            </form>

            <footer class="md-auth-footer">
                <p class="md-margin-none">
                    Already have an account?
                    <a href="/login" class="md-link">Sign in here</a>
                </p>
            </footer>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var NAME_PATTERN = /^[a-zA-Z\s]+$/;
            var PASSWORD_PATTERN = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/;
            var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            var form = document.getElementById('signup-form');
            if (!form) { return; }
            var nameField = document.getElementById('name');
            var emailField = document.getElementById('email');
            var passwordField = document.getElementById('password');
            var confirmField = document.getElementById('confirmPassword');
            var submitButton = document.getElementById('submitButton');

            function setError(field, errorId, message) {
                var el = document.getElementById(errorId);
                if (el) { el.textContent = message || ''; }
                field.setAttribute('aria-invalid', message ? 'true' : 'false');
                return !message;
            }

            function validateName() {
                var v = nameField.value.trim();
                if (!v) { return setError(nameField, 'name-error', 'Full name is required'); }
                if (v.length < 2 || v.length > 50) { return setError(nameField, 'name-error', 'Name must be 2-50 characters'); }
                if (!NAME_PATTERN.test(v)) { return setError(nameField, 'name-error', 'Letters and spaces only'); }
                return setError(nameField, 'name-error', '');
            }
            function validateEmail() {
                var v = emailField.value.trim();
                if (!v) { return setError(emailField, 'email-error', 'Email is required'); }
                if (!EMAIL_PATTERN.test(v)) { return setError(emailField, 'email-error', 'Please enter a valid email'); }
                return setError(emailField, 'email-error', '');
            }
            function validatePassword() {
                var v = passwordField.value;
                if (!v) { return setError(passwordField, 'password-error', 'Password is required'); }
                if (v.length < 6 || v.length > 128) { return setError(passwordField, 'password-error', 'Password must be 6-128 characters'); }
                if (!PASSWORD_PATTERN.test(v)) { return setError(passwordField, 'password-error', 'Need lowercase, uppercase and number'); }
                return setError(passwordField, 'password-error', '');
            }
            function validateConfirm() {
                var v = confirmField.value;
                if (!v) { return setError(confirmField, 'confirm-password-error', 'Please confirm password'); }
                if (v !== passwordField.value) { return setError(confirmField, 'confirm-password-error', 'Passwords do not match'); }
                return setError(confirmField, 'confirm-password-error', '');
            }

            nameField.addEventListener('blur', validateName);
            emailField.addEventListener('blur', validateEmail);
            passwordField.addEventListener('blur', validatePassword);
            confirmField.addEventListener('blur', validateConfirm);
            passwordField.addEventListener('input', function () {
                if (confirmField.value) { validateConfirm(); }
            });

            // Password toggles
            document.querySelectorAll('[data-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-toggle');
                    var input = document.getElementById(targetId);
                    if (!input) { return; }
                    var icon = btn.querySelector('i');
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    if (icon) { icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye'; }
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                });
            });

            form.addEventListener('submit', function (e) {
                var ok = [validateName(), validateEmail(), validatePassword(), validateConfirm()].every(Boolean);
                if (!ok) {
                    e.preventDefault();
                    var firstInvalid = form.querySelector('[aria-invalid="true"]');
                    if (firstInvalid) { firstInvalid.focus(); }
                    return;
                }
                submitButton.disabled = true;
                var label = submitButton.querySelector('.md-button-label');
                if (label) {
                    label.innerHTML = '<i class="bi bi-hourglass-split" aria-hidden="true"></i> Creating account...';
                }
            });
        });
    </script>
    <script src="/js/theme-toggle.js"></script>
</body>
</html>
