<%
    var statusRaw = (order && typeof order.status === 'string') ? order.status : 'pending';
    var statusKey = statusRaw.toLowerCase().replace(/\s+/g, '_');
    var statusLabel = statusRaw.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    var badgeClass = 'md-badge md-badge-default';
    if (statusKey === 'pending') { badgeClass = 'md-badge md-badge-pending'; }
    else if (statusKey === 'in_transit' || statusKey === 'in-transit') { badgeClass = 'md-badge md-badge-in-transit'; }
    else if (statusKey === 'delivered') { badgeClass = 'md-badge md-badge-delivered'; }
    else if (statusKey === 'cancelled' || statusKey === 'canceled') { badgeClass = 'md-badge md-badge-cancelled'; }
    var createdAt = order && order.created_at ? new Date(order.created_at) : null;
    var createdLabel = createdAt && !isNaN(createdAt.getTime()) ? createdAt.toLocaleString() : '—';
    var description = (order && typeof order.package_description === 'string' && order.package_description.trim().length > 0)
        ? order.package_description
        : null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order <%= order.id %> - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>

    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>
            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
            </button>
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/orders" role="menuitem" aria-current="page">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            My Orders
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders/new" role="menuitem">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            New Order
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" class="md-navbar-form">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="md-main" id="main-content" role="main">
        <div class="md-container">
            <header class="md-page-header" aria-labelledby="order-detail-heading">
                <div>
                    <a href="/orders" class="md-back-link md-body2 md-text-secondary">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        <span>Back to My Orders</span>
                    </a>
                    <h1 id="order-detail-heading" class="md-page-header-title">
                        <i class="bi bi-receipt" aria-hidden="true"></i>
                        Order #<%= order.id %>
                    </h1>
                    <p class="md-page-header-subtitle">Track the status and details of this delivery.</p>
                </div>
                <div class="md-page-header-actions">
                    <span class="<%= badgeClass %>" aria-label="Status: <%= statusLabel %>">
                        <i class="bi bi-circle-fill" aria-hidden="true"></i>
                        <%= statusLabel %>
                    </span>
                </div>
            </header>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="order-fields-heading">
                <h2 id="order-fields-heading" class="md-visually-hidden">Order details</h2>
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-10 md-col-lg-8">
                        <article class="md-card md-elevation-2 md-border-radius-md" aria-label="Order <%= order.id %> details">
                            <div class="md-card-content">
                                <div class="md-field-grid md-field-grid--two-col">
                                    <div class="md-field">
                                        <div class="md-field-label md-body2">
                                            <i class="bi bi-geo-alt md-text-primary" aria-hidden="true"></i>
                                            <span>Pickup Address</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body1"><%= order.pickup_address %></div>
                                    </div>
                                    <div class="md-field">
                                        <div class="md-field-label md-body2">
                                            <i class="bi bi-geo-alt-fill md-text-primary" aria-hidden="true"></i>
                                            <span>Delivery Address</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body1"><%= order.delivery_address %></div>
                                    </div>
                                    <div class="md-field md-field--full">
                                        <div class="md-field-label md-body2">
                                            <i class="bi bi-card-text md-text-primary" aria-hidden="true"></i>
                                            <span>Package Description</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body1 <%= description ? '' : 'md-field-value--placeholder' %>">
                                            <%= description ? description : 'No description provided.' %>
                                        </div>
                                    </div>
                                    <div class="md-field md-field--full">
                                        <div class="md-field-label md-body2">
                                            <i class="bi bi-calendar-date md-text-primary" aria-hidden="true"></i>
                                            <span>Placed</span>
                                        </div>
                                        <div class="md-field-value md-body1"><%= createdLabel %></div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <footer class="md-footer" role="contentinfo">
        <div class="md-container">
            <p class="md-body2 md-text-secondary md-text-center md-margin-none">&copy; 2026 Delivvr. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/theme-toggle.js"></script>
    <script>
        (function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && navMenu.classList.contains('show')) {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('show');
                    }
                });
            }
        })();
    </script>
</body>
</html>
