<%
    var statusRaw = (order && typeof order.status === 'string') ? order.status : 'pending';
    var statusLabel = statusRaw.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    var chipClass = 'md-chip';
    if (statusRaw === 'pending') { chipClass += ' md-chip-pending'; }
    else if (statusRaw === 'delivered') { chipClass += ' md-chip-delivered'; }
    else if (statusRaw === 'cancelled') { chipClass += ' md-chip-cancelled'; }
    else { chipClass += ' md-chip-active'; }
    var createdAt = order && order.created_at ? new Date(order.created_at) : null;
    var createdLabel = createdAt && !isNaN(createdAt.getTime()) ? createdAt.toLocaleString() : '—';
    var description = (order && typeof order.package_description === 'string' && order.package_description.trim().length > 0)
        ? order.package_description
        : null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order <%= order.id %> - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>

            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
            </button>

            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/orders" role="menuitem" aria-current="page">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            My Orders
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders/new" role="menuitem">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            New Order
                        </a>
                    </li>
                    <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/admin/orders" role="menuitem">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            Admin
                        </a>
                    </li>
                    <% } %>
                    <li class="md-navbar-item" role="none">
                        <form action="/logout" method="POST" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <section class="md-section md-padding-top-lg md-padding-bottom-md" aria-labelledby="order-detail-heading">
                <div class="md-row md-align-items-center md-justify-content-space-between">
                    <div class="md-col-12 md-col-md-8">
                        <a href="/orders" class="md-back-link md-body-medium md-text-secondary">
                            <i class="bi bi-arrow-left md-icon-small" aria-hidden="true"></i>
                            <span>Back to My Orders</span>
                        </a>
                        <h1 id="order-detail-heading" class="md-headline-medium md-text-primary md-margin-bottom-xs">
                            <i class="bi bi-hash md-icon-medium md-margin-right-sm" aria-hidden="true"></i>
                            Order <%= order.id %>
                        </h1>
                        <p class="md-body-medium md-text-secondary md-margin-0">
                            Track the status and details of this delivery order.
                        </p>
                    </div>
                </div>
            </section>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="order-fields-heading">
                <h2 id="order-fields-heading" class="md-visually-hidden">Order details</h2>
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-10 md-col-lg-8">
                        <article class="md-card md-elevation-2 md-border-radius-md" aria-label="Order <%= order.id %> details">
                            <div class="md-card-header md-card-header--split">
                                <h3 class="md-card-title md-headline-small md-margin-none md-text-on-primary">
                                    <i class="bi bi-receipt md-icon-medium" aria-hidden="true"></i>
                                    <span>Order #<%= order.id %></span>
                                </h3>
                                <span class="<%= chipClass %>" aria-label="Status: <%= statusLabel %>">
                                    <i class="bi bi-circle-fill" aria-hidden="true" style="font-size:0.5rem;margin-right:0.35rem;"></i>
                                    <%= statusLabel %>
                                </span>
                            </div>
                            <div class="md-card-content">
                                <div class="md-field-grid md-field-grid--two-col">
                                    <div class="md-field">
                                        <div class="md-field-label md-body-medium">
                                            <i class="bi bi-geo-alt md-icon-small md-text-primary" aria-hidden="true"></i>
                                            <span>Pickup</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body-medium"><%= order.pickup_address %></div>
                                    </div>

                                    <div class="md-field">
                                        <div class="md-field-label md-body-medium">
                                            <i class="bi bi-geo-alt-fill md-icon-small md-text-primary" aria-hidden="true"></i>
                                            <span>Delivery</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body-medium"><%= order.delivery_address %></div>
                                    </div>

                                    <div class="md-field md-field--full">
                                        <div class="md-field-label md-body-medium">
                                            <i class="bi bi-card-text md-icon-small md-text-primary" aria-hidden="true"></i>
                                            <span>Description</span>
                                        </div>
                                        <div class="md-field-value md-field-value--multiline md-body-medium <%= description ? '' : 'md-field-value--placeholder' %>">
                                            <%= description ? description : '—' %>
                                        </div>
                                    </div>

                                    <div class="md-field md-field--full">
                                        <div class="md-field-label md-body-medium">
                                            <i class="bi bi-calendar-date md-icon-small md-text-primary" aria-hidden="true"></i>
                                            <span>Placed</span>
                                        </div>
                                        <div class="md-field-value md-body-medium"><%= createdLabel %></div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="/js/theme-toggle.js"></script>
    <script>
        (function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
            }
        })();
    </script>
</body>
</html>
