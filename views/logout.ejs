<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3 text-gray-800">Logout</h1>
            <p class="mb-0 text-muted">You have been successfully logged out of your account.</p>
        </div>
    </div>

    <!-- Logout Confirmation Message -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div>
                    <h4 class="alert-heading mb-1">Successfully logged out!</h4>
                    <p class="mb-0">Your session has been terminated and you are now logged out of the Auth App.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow border-0">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-check text-success me-2" style="font-size: 1.5rem;"></i>
                        <h5 class="card-title mb-0">Session Terminated</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-box-arrow-right text-muted mb-3" style="font-size: 4rem;"></i>
                        <h4 class="mb-3">Thank you for using Auth App</h4>
                        <p class="text-muted mb-4">
                            Your account data is secure and your session has been properly terminated. 
                            All authentication cookies have been cleared from your browser.
                        </p>
                    </div>

                    <!-- Security Information -->
                    <div class="alert alert-info d-flex align-items-start mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                        <div>
                            <strong>Security Notice:</strong>
                            <p class="mb-0 mt-1">
                                For your security, we recommend closing your browser if you're using a shared computer. 
                                Your account remains protected and no personal information is stored locally.
                            </p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/login" class="btn btn-primary btn-lg me-md-2 d-flex align-items-center">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login Again
                        </a>
                        <a href="/" class="btn btn-outline-secondary btn-lg d-flex align-items-center">
                            <i class="bi bi-house me-2"></i>
                            Go to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Information Cards -->
    <div class="row mt-5">
        <div class="col-lg-4 mb-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-shield-lock text-primary mb-3" style="font-size: 2.5rem;"></i>
                    <h6 class="card-title">Secure Session</h6>
                    <p class="card-text text-muted small">
                        Your session was encrypted and securely terminated following industry best practices.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-clock-history text-success mb-3" style="font-size: 2.5rem;"></i>
                    <h6 class="card-title">Session Duration</h6>
                    <p class="card-text text-muted small">
                        You were logged in for approximately 2 hours and 34 minutes during this session.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-arrow-clockwise text-info mb-3" style="font-size: 2.5rem;"></i>
                    <h6 class="card-title">Quick Return</h6>
                    <p class="card-text text-muted small">
                        Use the login button above to quickly sign back in to your account anytime.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Message -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="text-center">
                <p class="text-muted small mb-0">
                    <i class="bi bi-heart-fill text-danger me-1"></i>
                    Thank you for choosing Auth App for your authentication needs
                </p>
            </div>
        </div>
    </div>
</div>