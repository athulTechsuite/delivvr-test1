<%- include('layout', { 
    title: 'Express Auth App - Home',
    bodyClass: 'home-page',
    user: null
}) %>

<!-- Hero Section -->
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 hero-card">
                <div class="card-body text-center p-5">
                    <h1 class="display-4 mb-4 text-white">Welcome to Express Auth App</h1>
                    <p class="lead mb-4 text-light">
                        A complete authentication system built with Express.js, featuring secure user registration, 
                        login functionality, JWT-based session management, and comprehensive profile management.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/signup" class="btn btn-primary btn-lg me-md-2 px-4 py-2">
                            <i class="bi bi-person-plus-fill me-2"></i>Get Started
                        </a>
                        <a href="/login" class="btn btn-outline-light btn-lg px-4 py-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container mt-5 py-4">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow feature-card border-0">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-shield-lock-fill text-primary"></i>
                    </div>
                    <h5 class="card-title text-white mb-3">Secure Authentication</h5>
                    <p class="card-text text-light">
                        Passwords are securely hashed using bcrypt and authentication 
                        is handled with JWT tokens for maximum security and session management.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow feature-card border-0">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-person-plus-fill text-primary"></i>
                    </div>
                    <h5 class="card-title text-white mb-3">Easy Registration</h5>
                    <p class="card-text text-light">
                        Simple and intuitive user registration process with 
                        comprehensive validation and immediate account activation.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow feature-card border-0">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-speedometer2 text-primary"></i>
                    </div>
                    <h5 class="card-title text-white mb-3">Profile Management</h5>
                    <p class="card-text text-light">
                        Access your personal dashboard with comprehensive profile management, 
                        inline editing capabilities, and secure session handling.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Features Section -->
<div class="container mt-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow feature-card border-0">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="text-white mb-3">Built with Modern Technologies</h4>
                            <p class="text-light mb-3">
                                Our authentication system leverages the latest web technologies including 
                                Express.js for robust backend API, EJS templating for dynamic content, 
                                Bootstrap for responsive design, and SQLite for reliable data storage.
                            </p>
                            <ul class="list-unstyled text-light">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>JWT-based session management</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Bcrypt password hashing</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Responsive dark theme design</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Inline profile editing</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Avatar upload support</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Input validation and sanitization</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>XSS protection implementation</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Mobile-responsive design</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Method override middleware for PUT/DELETE</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Comprehensive error handling</li>
                            </ul>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="tech-stack-icon">
                                <i class="bi bi-gear-fill text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.home-page {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
    min-height: 100vh;
}

.hero-card {
    background: linear-gradient(135deg, rgba(52, 73, 94, 0.9) 0%, rgba(44, 62, 80, 0.9) 100%);
    border-radius: 15px;
    backdrop-filter: blur(10px);
}

.feature-card {
    background: rgba(52, 73, 94, 0.8);
    border-radius: 12px;
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3) !important;
}

.feature-icon i {
    font-size: 3rem;
    color: #3498db;
}

.tech-stack-icon i {
    font-size: 5rem;
    color: #3498db;
    opacity: 0.7;
}

.btn-primary {
    background-color: #3498db;
    border-color: #3498db;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background-color: #2980b9;
    border-color: #2980b9;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);
}

.btn-outline-light {
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-outline-light:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 255, 255, 0.2);
}

.card-text {
    font-size: 0.95rem;
    line-height: 1.6;
}

.display-4 {
    font-weight: 700;
    letter-spacing: -1px;
}

.lead {
    font-size: 1.1rem;
    line-height: 1.7;
}

@media (max-width: 768px) {
    .hero-card .card-body {
        padding: 2rem 1.5rem !important;
    }
    
    .display-4 {
        font-size: 2rem;
    }
    
    .feature-icon i {
        font-size: 2.5rem;
    }
    
    .tech-stack-icon i {
        font-size: 3.5rem;
        margin-top: 2rem;
    }
}
</style>

