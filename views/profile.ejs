<%- include('layout', { title: 'Profile', currentPage: 'profile' }) %>

<!-- Profile Content -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2"><i class="bi bi-person-circle me-2"></i>Profile</h1>
        </div>

        <!-- User Profile Information -->
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Full Name:</strong></td>
                                <td><%= user.name %></td>
                            </tr>
                            <tr>
                                <td><strong>Email Address:</strong></td>
                                <td><%= user.email %></td>
                            </tr>
                            <tr>
                                <td><strong>User ID:</strong></td>
                                <td><%= user.id %></td>
                            </tr>
                            <tr>
                                <td><strong>Account Created:</strong></td>
                                <td><%= new Date(user.created_at).toLocaleDateString('en-US', { 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %></td>
                            </tr>
                        </table>
                        
                        <div class="mt-3">
                            <button class="btn btn-primary me-2" type="button">
                                <i class="bi bi-pencil-square me-2"></i>Edit Profile
                            </button>
                            <button class="btn btn-outline-secondary" type="button">
                                <i class="bi bi-envelope me-2"></i>Update Email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-image me-2"></i>Profile Picture</h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="bi bi-person-circle display-3 text-muted"></i>
                        </div>
                        <p class="text-muted small mb-3">No profile picture uploaded</p>
                        <button class="btn btn-outline-primary btn-sm" type="button">
                            <i class="bi bi-upload me-2"></i>Change Avatar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Statistics -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-primary mb-1">
                            <i class="bi bi-calendar-check"></i>
                        </h2>
                        <h4 class="mb-1"><%= Math.floor((new Date() - new Date(user.created_at)) / (1000 * 60 * 60 * 24)) %></h4>
                        <p class="text-muted small mb-0">Days Active</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-success mb-1">
                            <i class="bi bi-shield-check"></i>
                        </h2>
                        <h4 class="mb-1">Active</h4>
                        <p class="text-muted small mb-0">Account Status</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-info mb-1">
                            <i class="bi bi-clock-history"></i>
                        </h2>
                        <h4 class="mb-1">0</h4>
                        <p class="text-muted small mb-0">Login Sessions</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row mb-4">
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-activity me-2"></i>Recent Activity</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex align-items-center px-0">
                                <i class="bi bi-box-arrow-in-right text-success me-3"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">Account Login</div>
                                    <small class="text-muted">Logged in from web browser</small>
                                </div>
                                <small class="text-muted">Today</small>
                            </div>
                            <div class="list-group-item d-flex align-items-center px-0">
                                <i class="bi bi-person-plus text-primary me-3"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">Account Created</div>
                                    <small class="text-muted">Welcome to the platform</small>
                                </div>
                                <small class="text-muted"><%= new Date(user.created_at).toLocaleDateString() %></small>
                            </div>
                        </div>
                        
                        <div class="mt-3">
                            <a href="#" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-clock-history me-2"></i>View Full Activity Log
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Account Preferences</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" value="" id="emailNotifications" checked disabled>
                            <label class="form-check-label" for="emailNotifications">
                                Email Notifications
                            </label>
                            <small class="text-muted d-block">Receive important account updates</small>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" value="" id="securityAlerts" checked disabled>
                            <label class="form-check-label" for="securityAlerts">
                                Security Alerts
                            </label>
                            <small class="text-muted d-block">Notify about login attempts</small>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" value="" id="marketingEmails" disabled>
                            <label class="form-check-label" for="marketingEmails">
                                Marketing Updates
                            </label>
                            <small class="text-muted d-block">Product news and announcements</small>
                        </div>
                        
                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm" type="button">
                                <i class="bi bi-sliders me-2"></i>Manage Preferences
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Settings Overview -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Security & Privacy</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Password Security</h6>
                                <p class="text-muted small mb-3">Last updated: <%= new Date(user.created_at).toLocaleDateString() %></p>
                                <button class="btn btn-outline-warning btn-sm mb-3" type="button">
                                    <i class="bi bi-key me-2"></i>Change Password
                                </button>
                            </div>
                            
                            <div class="col-md-6">
                                <h6 class="fw-bold">Two-Factor Authentication</h6>
                                <p class="text-muted small mb-3">Status: <span class="text-warning">Not Enabled</span></p>
                                <button class="btn btn-outline-success btn-sm mb-3" type="button">
                                    <i class="bi bi-shield-plus me-2"></i>Enable 2FA
                                </button>
                            </div>
                        </div>
                        
                        <hr>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Privacy Settings</h6>
                                <p class="text-muted small mb-3">Control who can see your profile information</p>
                                <button class="btn btn-outline-info btn-sm" type="button">
                                    <i class="bi bi-eye me-2"></i>Privacy Controls
                                </button>
                            </div>
                            
                            <div class="col-md-6">
                                <h6 class="fw-bold">Data Export</h6>
                                <p class="text-muted small mb-3">Download your account data and activity</p>
                                <button class="btn btn-outline-secondary btn-sm" type="button">
                                    <i class="bi bi-download me-2"></i>Export Data
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout-footer') %>