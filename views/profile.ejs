<% 
// Set page title for layout.ejs integration
const pageTitle = 'Profile';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Express Auth App</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,0,1;wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link" aria-label="Express Auth App Home">
                    <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                    <span>Express Auth</span>
                </a>
            </div>
            
            <!-- Mobile Menu Toggle -->
            <button class="md-navbar-toggle" type="button" id="navbar-toggle" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
            </button>
            
            <!-- Navigation Links -->
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link active" href="/profile" role="menuitem" aria-current="page">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            Profile
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form method="POST" action="/logout" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-logout-btn" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-item" role="none">
                        <div class="md-theme-toggle" role="menuitem" aria-label="Toggle theme">
                            <input type="checkbox" id="theme-toggle" class="md-theme-toggle-input" aria-labelledby="theme-toggle-label">
                            <label for="theme-toggle" class="md-theme-toggle-label" id="theme-toggle-label">
                                <span class="md-theme-toggle-slider">
                                    <i class="bi bi-sun-fill md-theme-icon md-theme-icon-light" aria-hidden="true"></i>
                                    <i class="bi bi-moon-fill md-theme-icon md-theme-icon-dark" aria-hidden="true"></i>
                                </span>
                                <span class="sr-only">Toggle between light and dark theme</span>
                            </label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <!-- Profile Header Section -->
            <section class="md-section" aria-labelledby="profile-heading">
                <div class="md-row">
                    <div class="md-col-12">
                        <h1 id="profile-heading" class="md-display-small md-text-primary">
                            <i class="bi bi-person-circle md-icon-large" aria-hidden="true"></i>
                            User Profile
                        </h1>
                        <p class="md-body-large md-text-secondary md-margin-bottom-lg">
                            View and edit your account information and profile details
                        </p>
                    </div>
                </div>
            </section>

            <!-- Success/Error Message Display -->
            <section class="md-section" id="message-section" style="display: none;" aria-live="polite">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8 md-col-lg-6">
                        <div id="success-message" class="md-alert md-alert-success" role="alert" style="display: none;">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            <span id="success-text">Profile updated successfully</span>
                        </div>
                        <div id="error-message" class="md-alert md-alert-error" role="alert" style="display: none;">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <span id="error-text"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Profile Card Section -->
            <section class="md-section" aria-labelledby="profile-info-heading">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8 md-col-lg-6">
                        <div class="md-card md-elevation-2" role="region" aria-labelledby="profile-info-heading">
                            <!-- Card Header -->
                            <div class="md-card-header">
                                <div class="md-card-header-content">
                                    <i class="bi bi-person-badge md-icon-medium md-text-primary" aria-hidden="true"></i>
                                    <div class="md-card-header-text">
                                        <h2 id="profile-info-heading" class="md-headline-small md-text-primary md-margin-bottom-none">
                                            Profile Information
                                        </h2>
                                        <p class="md-body-medium md-text-secondary md-margin-bottom-none">
                                            Your account details and membership information
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="md-card-body">
                                <% if (typeof user !== 'undefined' && user) { %>
                                    <!-- Profile Picture Section -->
                                    <div class="md-profile-item" role="group" aria-labelledby="profile-picture-label">
                                        <div class="md-profile-item-icon">
                                            <i class="bi bi-image-fill md-text-primary" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-item-content">
                                            <dt id="profile-picture-label" class="md-label-large md-text-secondary">
                                                Profile Picture
                                            </dt>
                                            <dd class="md-profile-picture-container">
                                                <!-- View Mode Profile Picture -->
                                                <div id="profile-picture-view" class="md-profile-picture-view">
                                                    <% if (user.profile_picture) { %>
                                                        <img id="profile-picture-display" src="/<%= user.profile_picture %>" alt="Profile picture" class="md-profile-picture" />
                                                    <% } else { %>
                                                        <div id="profile-picture-placeholder" class="md-profile-picture-placeholder">
                                                            <i class="bi bi-person-fill" aria-hidden="true"></i>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                
                                                <!-- Edit Mode Profile Picture Upload -->
                                                <div id="profile-picture-edit" class="md-profile-picture-edit" style="display: none;">
                                                    <div class="md-file-upload-container">
                                                        <input type="file" id="profile-picture-input" name="profilePicture" accept="image/jpeg,image/jpg,image/png,image/gif" class="md-file-input" aria-describedby="profile-picture-help" />
                                                        <label for="profile-picture-input" class="md-file-upload-label" role="button" aria-describedby="profile-picture-help">
                                                            <i class="bi bi-cloud-upload-fill" aria-hidden="true"></i>
                                                            Choose New Picture
                                                        </label>
                                                        <div id="profile-picture-preview" class="md-profile-picture-preview" style="display: none;">
                                                            <img id="profile-picture-preview-img" src="" alt="Preview" class="md-profile-picture" />
                                                        </div>
                                                        <p id="profile-picture-help" class="md-body-small md-text-secondary">
                                                            Max file size: 5MB. Formats: JPG, PNG, GIF
                                                        </p>
                                                        <div id="profile-picture-error" class="md-field-error" style="display: none;" role="alert" aria-live="polite"></div>
                                                    </div>
                                                </div>
                                            </dd>
                                        </div>
                                    </div>

                                    <!-- User Name -->
                                    <div class="md-profile-item" role="group" aria-labelledby="name-label">
                                        <div class="md-profile-item-icon">
                                            <i class="bi bi-person-fill md-text-primary" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-item-content">
                                            <dt id="name-label" class="md-label-large md-text-secondary">
                                                Full Name
                                            </dt>
                                            <dd class="md-profile-field-container">
                                                <!-- View Mode -->
                                                <span id="name-view" class="md-body-large md-text-primary md-font-medium">
                                                    <%= typeof user.name === 'string' ? user.name : 'N/A' %>
                                                </span>
                                                
                                                <!-- Edit Mode -->
                                                <div id="name-edit" class="md-field-group" style="display: none;">
                                                    <input type="text" id="name-input" name="name" value="<%= typeof user.name === 'string' ? user.name : '' %>" 
                                                           class="md-text-field" placeholder="Enter your full name" 
                                                           aria-describedby="name-help name-error" maxlength="50" />
                                                    <p id="name-help" class="md-body-small md-text-secondary">
                                                        2-50 characters, letters and spaces only
                                                    </p>
                                                    <div id="name-error" class="md-field-error" style="display: none;" role="alert" aria-live="polite"></div>
                                                </div>
                                            </dd>
                                        </div>
                                    </div>

                                    <!-- Email Address -->
                                    <div class="md-profile-item" role="group" aria-labelledby="email-label">
                                        <div class="md-profile-item-icon">
                                            <i class="bi bi-envelope-fill md-text-primary" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-item-content">
                                            <dt id="email-label" class="md-label-large md-text-secondary">
                                                Email Address
                                            </dt>
                                            <dd class="md-profile-field-container">
                                                <!-- View Mode -->
                                                <span id="email-view" class="md-body-large md-text-primary md-font-medium">
                                                    <%= typeof user.email === 'string' ? user.email : 'N/A' %>
                                                </span>
                                                
                                                <!-- Edit Mode -->
                                                <div id="email-edit" class="md-field-group" style="display: none;">
                                                    <input type="email" id="email-input" name="email" value="<%= typeof user.email === 'string' ? user.email : '' %>" 
                                                           class="md-text-field" placeholder="Enter your email address" 
                                                           aria-describedby="email-help email-error" />
                                                    <p id="email-help" class="md-body-small md-text-secondary">
                                                        Valid email format required
                                                    </p>
                                                    <div id="email-error" class="md-field-error" style="display: none;" role="alert" aria-live="polite"></div>
                                                </div>
                                            </dd>
                                        </div>
                                    </div>

                                    <!-- Member Since -->
                                    <div class="md-profile-item" role="group" aria-labelledby="member-since-label">
                                        <div class="md-profile-item-icon">
                                            <i class="bi bi-calendar-check-fill md-text-primary" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-item-content">
                                            <dt id="member-since-label" class="md-label-large md-text-secondary">
                                                Member Since
                                            </dt>
                                            <dd class="md-body-large md-text-primary md-font-medium">
                                                <% 
                                                try {
                                                    const createdAt = user.created_at;
                                                    if (createdAt) {
                                                        const date = new Date(createdAt);
                                                        if (!isNaN(date.getTime())) {
                                                            const formattedDate = date.toLocaleDateString('en-US', {
                                                                year: 'numeric',
                                                                month: 'long',
                                                                day: 'numeric'
                                                            });
                                                %>
                                                            <%= formattedDate %>
                                                <% 
                                                        } else {
                                                %>
                                                            N/A
                                                <% 
                                                        }
                                                    } else {
                                                %>
                                                        N/A
                                                <% 
                                                    }
                                                } catch (error) {
                                                %>
                                                    N/A
                                                <% 
                                                }
                                                %>
                                            </dd>
                                        </div>
                                    </div>

                                    <!-- Account Status -->
                                    <div class="md-profile-item" role="group" aria-labelledby="status-label">
                                        <div class="md-profile-item-icon">
                                            <i class="bi bi-check-circle-fill md-text-success" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-item-content">
                                            <dt id="status-label" class="md-label-large md-text-secondary">
                                                Account Status
                                            </dt>
                                            <dd class="md-body-large md-text-success md-font-medium">
                                                Active
                                            </dd>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <!-- Error State -->
                                    <div class="md-profile-error" role="alert" aria-live="polite">
                                        <div class="md-profile-error-icon">
                                            <i class="bi bi-exclamation-triangle-fill md-text-error" aria-hidden="true"></i>
                                        </div>
                                        <div class="md-profile-error-content">
                                            <h3 class="md-title-medium md-text-error md-margin-bottom-sm">
                                                Profile Information Unavailable
                                            </h3>
                                            <p class="md-body-medium md-text-secondary md-margin-bottom-none">
                                                We're unable to load your profile information at this time. Please try refreshing the page or contact support if the problem persists.
                                            </p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Card Actions -->
                            <div class="md-card-actions">
                                <!-- View Mode Actions -->
                                <div id="view-actions" class="md-button-group">
                                    <button id="edit-profile-btn" type="button" class="md-button md-button-filled" aria-describedby="edit-profile-help">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        Edit Profile
                                    </button>
                                    <a href="/dashboard" class="md-button md-button-text" role="button">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        Back to Dashboard
                                    </a>
                                </div>

                                <!-- Edit Mode Actions -->
                                <div id="edit-actions" class="md-button-group" style="display: none;">
                                    <button id="save-profile-btn" type="button" class="md-button md-button-filled" aria-describedby="save-profile-help">
                                        <span id="save-btn-text">
                                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                                            Save Changes
                                        </span>
                                        <span id="save-btn-loading" style="display: none;">
                                            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                                            Saving...
                                        </span>
                                    </button>
                                    <button id="cancel-profile-btn" type="button" class="md-button md-button-outlined">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Additional Actions Section -->
            <section class="md-section" aria-labelledby="actions-heading">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8 md-col-lg-6">
                        <div class="md-card md-elevation-1" role="region" aria-labelledby="actions-heading">
                            <div class="md-card-header">
                                <h2 id="actions-heading" class="md-headline-small md-text-primary">
                                    Quick Actions
                                </h2>
                            </div>
                            <div class="md-card-body">
                                <div class="md-button-group">
                                    <a href="/dashboard" class="md-button md-button-outlined" role="button">
                                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                        Go to Dashboard
                                    </a>
                                    <form method="POST" action="/logout" style="display: inline;">
                                        <button type="submit" class="md-button md-button-outlined md-button-error" role="button">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                            Sign Out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <footer class="md-footer" role="contentinfo">
        <div class="md-container">
            <div class="md-footer-content">
                <p class="md-body-small md-text-secondary md-margin-bottom-none">
                    &copy; 2024 Express Auth App. Built with Material Design principles.
                </p>
            </div>
        </div>
    </footer>

    <!-- Mobile Navigation Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navToggle = document.getElementById('navbar-toggle');
            const navMenu = document.getElementById('navbarNav');
            
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function() {
                    const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
                    navToggle.setAttribute('aria-expanded', !isExpanded);
                    navMenu.classList.toggle('md-navbar-nav-open');
                    navToggle.classList.toggle('md-navbar-toggle-active');
                });
                
                // Close menu when clicking outside
                document.addEventListener('click', function(event) {
                    if (!navToggle.contains(event.target) && !navMenu.contains(event.target)) {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('md-navbar-nav-open');
                        navToggle.classList.remove('md-navbar-toggle-active');
                    }
                });
                
                // Close menu on escape key
                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape') {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('md-navbar-nav-open');
                        navToggle.classList.remove('md-navbar-toggle-active');
                    }
                });
            }
        });
    </script>

    <!-- Profile Editing Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Constants
            const MAX_FILE_SIZE = 5242880; // 5MB
            const ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            const NAME_PATTERN = /^[a-zA-Z\s]+$/;
            const MIN_NAME_LENGTH = 2;
            const MAX_NAME_LENGTH = 50;
            const MESSAGE_DISPLAY_DURATION = 3000;

            // Elements
            const editProfileBtn = document.getElementById('edit-profile-btn');
            const saveProfileBtn = document.getElementById('save-profile-btn');
            const cancelProfileBtn = document.getElementById('cancel-profile-btn');
            const viewActions = document.getElementById('view-actions');
            const editActions = document.getElementById('edit-actions');
            const messageSection = document.getElementById('message-section');
            const successMessage = document.getElementById('success-message');
            const errorMessage = document.getElementById('error-message');
            const successText = document.getElementById('success-text');
            const errorText = document.getElementById('error-text');
            const saveBtnText = document.getElementById('save-btn-text');
            const saveBtnLoading = document.getElementById('save-btn-loading');

            // Profile Picture Elements
            const profilePictureView = document.getElementById('profile-picture-view');
            const profilePictureEdit = document.getElementById('profile-picture-edit');
            const profilePictureInput = document.getElementById('profile-picture-input');
            const profilePicturePreview = document.getElementById('profile-picture-preview');
            const profilePicturePreviewImg = document.getElementById('profile-picture-preview-img');
            const profilePictureError = document.getElementById('profile-picture-error');

            // Field Elements
            const nameView = document.getElementById('name-view');
            const nameEdit = document.getElementById('name-edit');
            const nameInput = document.getElementById('name-input');
            const nameError = document.getElementById('name-error');
            const emailView = document.getElementById('email-view');
            const emailEdit = document.getElementById('email-edit');
            const emailInput = document.getElementById('email-input');
            const emailError = document.getElementById('email-error');

            // Store original values
            let originalName = nameInput ? nameInput.value : '';
            let originalEmail = emailInput ? emailInput.value : '';
            let selectedFile = null;

            // Toggle between view and edit modes
            function toggleEditMode(isEditing) {
                if (isEditing) {
                    // Switch to edit mode
                    viewActions.style.display = 'none';
                    editActions.style.display = 'block';
                    profilePictureView.style.display = 'none';
                    profilePictureEdit.style.display = 'block';
                    nameView.style.display = 'none';
                    nameEdit.style.display = 'block';
                    emailView.style.display = 'none';
                    emailEdit.style.display = 'block';
                    
                    // Focus first input
                    if (nameInput) {
                        nameInput.focus();
                    }
                } else {
                    // Switch to view mode
                    viewActions.style.display = 'block';
                    editActions.style.display = 'none';
                    profilePictureView.style.display = 'block';
                    profilePictureEdit.style.display = 'none';
                    nameView.style.display = 'block';
                    nameEdit.style.display = 'none';
                    emailView.style.display = 'block';
                    emailEdit.style.display = 'none';
                    
                    // Clear validation errors
                    clearFieldError('name');
                    clearFieldError('email');
                    clearFieldError('profile-picture');
                }
            }

            // Validation functions
            function validateName(name) {
                if (!name || typeof name !== 'string') {
                    return 'Name is required';
                }
                
                const trimmedName = name.trim();
                if (trimmedName.length < MIN_NAME_LENGTH || trimmedName.length > MAX_NAME_LENGTH) {
                    return `Name must be between ${MIN_NAME_LENGTH} and ${MAX_NAME_LENGTH} characters`;
                }
                
                if (!NAME_PATTERN.test(trimmedName)) {
                    return 'Name can only contain letters and spaces';
                }
                
                return null;
            }

            function validateEmail(email) {
                if (!email || typeof email !== 'string') {
                    return 'Email is required';
                }
                
                const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailPattern.test(email.trim())) {
                    return 'Please enter a valid email address';
                }
                
                return null;
            }

            function validateProfilePicture(file) {
                if (!file) {
                    return null; // Optional field
                }
                
                if (file.size > MAX_FILE_SIZE) {
                    return 'File size must be less than 5MB';
                }
                
                if (!ALLOWED_TYPES.includes(file.type)) {
                    return 'Please select a valid image file (JPG, PNG, GIF)';
                }
                
                return null;
            }

            // Display field error
            function showFieldError(fieldName, message) {
                const errorElement = document.getElementById(`${fieldName}-error`);
                const inputElement = document.getElementById(`${fieldName}-input`);
                
                if (errorElement && message) {
                    errorElement.textContent = message;
                    errorElement.style.display = 'block';
                    errorElement.setAttribute('aria-live', 'polite');
                }
                
                if (inputElement) {
                    inputElement.classList.add('md-text-field-error');
                    inputElement.setAttribute('aria-invalid', 'true');
                }
            }

            // Clear field error
            function clearFieldError(fieldName) {
                const errorElement = document.getElementById(`${fieldName}-error`);
                const inputElement = document.getElementById(`${fieldName}-input`);
                
                if (errorElement) {
                    errorElement.style.display = 'none';
                    errorElement.textContent = '';
                }
                
                if (inputElement) {
                    inputElement.classList.remove('md-text-field-error');
                    inputElement.removeAttribute('aria-invalid');
                }
            }

            // Show message
            function showMessage(type, message) {
                messageSection.style.display = 'block';
                
                if (type === 'success') {
                    successMessage.style.display = 'block';
                    errorMessage.style.display = 'none';
                    successText.textContent = message;
                } else {
                    errorMessage.style.display = 'block';
                    successMessage.style.display = 'none';
                    errorText.textContent = message;
                }
                
                // Auto-hide after duration
                setTimeout(() => {
                    hideMessage();
                }, MESSAGE_DISPLAY_DURATION);
                
                // Scroll to message
                messageSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            // Hide message
            function hideMessage() {
                messageSection.style.display = 'none';
                successMessage.style.display = 'none';
                errorMessage.style.display = 'none';
            }

            // Set loading state
            function setLoadingState(isLoading) {
                if (isLoading) {
                    saveBtnText.style.display = 'none';
                    saveBtnLoading.style.display = 'inline-flex';
                    saveProfileBtn.disabled = true;
                    cancelProfileBtn.disabled = true;
                } else {
                    saveBtnText.style.display = 'inline-flex';
                    saveBtnLoading.style.display = 'none';
                    saveProfileBtn.disabled = false;
                    cancelProfileBtn.disabled = false;
                }
            }

            // Handle profile picture change
            if (profilePictureInput) {
                profilePictureInput.addEventListener('change', function(event) {
                    const file = event.target.files[0];
                    clearFieldError('profile-picture');
                    
                    if (file) {
                        const error = validateProfilePicture(file);
                        if (error) {
                            showFieldError('profile-picture', error);
                            profilePicturePreview.style.display = 'none';
                            selectedFile = null;
                            return;
                        }
                        
                        selectedFile = file;
                        
                        // Show preview
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            profilePicturePreviewImg.src = e.target.result;
                            profilePicturePreview.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else {
                        profilePicturePreview.style.display = 'none';
                        selectedFile = null;
                    }
                });
            }

            // Input validation on blur
            if (nameInput) {
                nameInput.addEventListener('blur', function() {
                    const error = validateName(this.value);
                    if (error) {
                        showFieldError('name', error);
                    } else {
                        clearFieldError('name');
                    }
                });
            }

            if (emailInput) {
                emailInput.addEventListener('blur', function() {
                    const error = validateEmail(this.value);
                    if (error) {
                        showFieldError('email', error);
                    } else {
                        clearFieldError('email');
                    }
                });
            }

            // Edit button handler
            if (editProfileBtn) {
                editProfileBtn.addEventListener('click', function() {
                    toggleEditMode(true);
                });
            }

            // Cancel button handler
            if (cancelProfileBtn) {
                cancelProfileBtn.addEventListener('click', function() {
                    // Reset values
                    if (nameInput) {
                        nameInput.value = originalName;
                    }
                    if (emailInput) {
                        emailInput.value = originalEmail;
                    }
                    if (profilePictureInput) {
                        profilePictureInput.value = '';
                    }
                    
                    selectedFile = null;
                    profilePicturePreview.style.display = 'none';
                    hideMessage();
                    toggleEditMode(false);
                });
            }

            // Save button handler
            if (saveProfileBtn) {
                saveProfileBtn.addEventListener('click', async function() {
                    // Validate all fields
                    let hasErrors = false;
                    
                    const nameError = validateName(nameInput?.value);
                    const emailError = validateEmail(emailInput?.value);
                    const pictureError = validateProfilePicture(selectedFile);
                    
                    if (nameError) {
                        showFieldError('name', nameError);
                        hasErrors = true;
                    } else {
                        clearFieldError('name');
                    }
                    
                    if (emailError) {
                        showFieldError('email', emailError);
                        hasErrors = true;
                    } else {
                        clearFieldError('email');
                    }
                    
                    if (pictureError) {
                        showFieldError('profile-picture', pictureError);
                        hasErrors = true;
                    } else {
                        clearFieldError('profile-picture');
                    }
                    
                    if (hasErrors) {
                        return;
                    }
                    
                    // Prepare form data
                    const formData = new FormData();
                    formData.append('name', nameInput?.value?.trim() || '');
                    formData.append('email', emailInput?.value?.trim() || '');
                    
                    if (selectedFile) {
                        formData.append('profilePicture', selectedFile);
                    }
                    
                    try {
                        setLoadingState(true);
                        hideMessage();
                        
                        const response = await fetch('/profile', {
                            method: 'POST',
                            body: formData,
                            credentials: 'include'
                        });
                        
                        const data = await response.json();
                        
                        if (response.ok && data.success) {
                            // Update view with new data
                            if (nameView && data.user?.name) {
                                nameView.textContent = data.user.name;
                                originalName = data.user.name;
                            }
                            
                            if (emailView && data.user?.email) {
                                emailView.textContent = data.user.email;
                                originalEmail = data.user.email;
                            }
                            
                            // Update profile picture display
                            if (data.user?.profile_picture) {
                                const profilePictureDisplay = document.getElementById('profile-picture-display');
                                const profilePicturePlaceholder = document.getElementById('profile-picture-placeholder');
                                
                                if (profilePicturePlaceholder) {
                                    profilePicturePlaceholder.style.display = 'none';
                                }
                                
                                if (profilePictureDisplay) {
                                    profilePictureDisplay.src = '/' + data.user.profile_picture;
                                    profilePictureDisplay.style.display = 'block';
                                } else {
                                    // Create image element if it doesn't exist
                                    const img = document.createElement('img');
                                    img.id = 'profile-picture-display';
                                    img.src = '/' + data.user.profile_picture;
                                    img.alt = 'Profile picture';
                                    img.className = 'md-profile-picture';
                                    profilePictureView.appendChild(img);
                                }
                            }
                            
                            // Reset form state
                            selectedFile = null;
                            if (profilePictureInput) {
                                profilePictureInput.value = '';
                            }
                            profilePicturePreview.style.display = 'none';
                            
                            showMessage('success', 'Profile updated successfully');
                            
                            // Switch to view mode after message
                            setTimeout(() => {
                                toggleEditMode(false);
                            }, MESSAGE_DISPLAY_DURATION);
                            
                        } else {
                            const errorMessage = data.message || 'Failed to update profile';
                            showMessage('error', errorMessage);
                            
                            // Handle field-specific errors
                            if (data.errors) {
                                Object.keys(data.errors).forEach(field => {
                                    showFieldError(field, data.errors[field]);
                                });
                            }
                        }
                        
                    } catch (error) {
                        console.error('Profile update error:', error);
                        showMessage('error', 'An error occurred while updating your profile. Please try again.');
                    } finally {
                        setLoadingState(false);
                    }
                });
            }

            // Handle keyboard navigation
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && editActions.style.display === 'block') {
                    cancelProfileBtn?.click();
                }
            });
        });
    </script>
    
    <!-- Theme Toggle Script -->
    <script src="/js/theme-toggle.js"></script>
</body>
</html>