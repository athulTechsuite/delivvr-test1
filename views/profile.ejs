<% 
// Set page title for layout.ejs integration
const pageTitle = 'Profile';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - Delivvr</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,0,1;wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="md-body">
    <!-- Main Navigation -->
    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>
            
            <!-- Mobile Menu Toggle -->
            <button class="md-navbar-toggle" type="button" id="navbar-toggle" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
            </button>
            
            <!-- Navigation Links -->
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link active" href="/profile" role="menuitem" aria-current="page">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            Profile
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form method="POST" action="/logout" style="display: inline;">
                            <button type="submit" class="md-navbar-link md-navbar-logout-btn" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-item" role="none">
                        <div class="md-theme-toggle" role="menuitem" aria-label="Toggle theme">
                            <input type="checkbox" id="theme-toggle" class="md-theme-toggle-input" aria-labelledby="theme-toggle-label">
                            <label for="theme-toggle" class="md-theme-toggle-label" id="theme-toggle-label">
                                <span class="md-theme-toggle-slider">
                                    <i class="bi bi-sun-fill md-theme-icon md-theme-icon-light" aria-hidden="true"></i>
                                    <i class="bi bi-moon-fill md-theme-icon md-theme-icon-dark" aria-hidden="true"></i>
                                </span>
                                <span class="sr-only">Toggle between light and dark theme</span>
                            </label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="md-main" role="main">
        <div class="md-container">
            <!-- Profile Header & Card -->
            <section class="md-section" aria-labelledby="profile-info-heading">
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-8 md-col-lg-6">
                        <%
                            // Compute initials
                            const _rawName = (user && (user.name || user.username || user.email)) ? (user.name || user.username || user.email) : 'U';
                            const _nameParts = _rawName.trim().split(/\s+/);
                            const _initials = _nameParts.length > 1
                                ? (_nameParts[0][0] + _nameParts[1][0]).toUpperCase()
                                : _rawName.substring(0, 2).toUpperCase();
                        %>

                        <!-- Circular Avatar -->
                        <div class="md-text-center" style="margin-bottom:1.5rem;">
                            <div class="md-avatar"><%= _initials %></div>
                            <h1 id="profile-heading" class="md-headline-medium md-text-primary" style="margin:0;">
                                <%= (user && (user.name || user.username)) ? (user.name || user.username) : 'User' %>
                            </h1>
                            <p class="md-body-medium md-text-secondary" style="margin:0.25rem 0 0;">
                                Delivvr Member
                                <span class="md-chip md-chip-active" style="margin-left:0.5rem;"><i class="bi bi-check-circle"></i> Active</span>
                            </p>
                        </div>

                        <div class="md-card md-elevation-2" role="region" aria-labelledby="profile-info-heading">
                            <!-- Card Header -->
                            <div class="md-card-header">
                                <h2 id="profile-info-heading" style="color:#fff;margin:0;font-size:1.1rem;font-weight:600;">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                                    Profile Information
                                </h2>
                            </div>

                            <!-- Card Body -->
                            <div class="md-card-body">
                                <% if (typeof user !== 'undefined' && user) { %>

                                    <!-- Full Name -->
                                    <div class="md-profile-item">
                                        <i class="bi bi-person-fill" aria-hidden="true"></i>
                                        <span class="label">Full Name</span>
                                        <span class="value"><%= typeof user.name === 'string' ? user.name : (user.username || 'N/A') %></span>
                                    </div>

                                    <!-- Email -->
                                    <div class="md-profile-item">
                                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                                        <span class="label">Email</span>
                                        <span class="value"><%= typeof user.email === 'string' ? user.email : 'N/A' %></span>
                                    </div>

                                    <!-- Username -->
                                    <% if (user.username) { %>
                                    <div class="md-profile-item">
                                        <i class="bi bi-at" aria-hidden="true"></i>
                                        <span class="label">Username</span>
                                        <span class="value"><%= user.username %></span>
                                    </div>
                                    <% } %>

                                    <!-- Member Since -->
                                    <div class="md-profile-item">
                                        <i class="bi bi-calendar-check-fill" aria-hidden="true"></i>
                                        <span class="label">Member Since</span>
                                        <span class="value">
                                        <%
                                        try {
                                            const createdAt = user.created_at;
                                            if (createdAt) {
                                                const d = new Date(createdAt);
                                                if (!isNaN(d.getTime())) { %>
                                                    <%= d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                <% } else { %>N/A<% }
                                            } else { %>N/A<% }
                                        } catch(e) { %>N/A<% }
                                        %>
                                        </span>
                                    </div>

                                    <!-- Account Status -->
                                    <div class="md-profile-item">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                                        <span class="label">Status</span>
                                        <span class="value">
                                            <span class="md-chip md-chip-active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                        </span>
                                    </div>

                                <% } else { %>
                                    <!-- Error State -->
                                    <div class="md-profile-error" role="alert" aria-live="polite">
                                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                        <div>
                                            <strong>Profile Unavailable</strong>
                                            <p style="margin:0.25rem 0 0;font-size:0.875rem;">
                                                We're unable to load your profile information. Please refresh or contact support.
                                            </p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Card Actions with Button Group -->
                            <div class="md-card-body" style="border-top:1px solid rgba(0,0,0,0.08);">
                                <div class="md-button-group">
                                    <a href="/dashboard" class="md-button md-button--contained"
                                       style="background:var(--primary,#FF6B00);color:#fff;padding:0 1.5rem;height:40px;border-radius:6px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                                        <i class="bi bi-speedometer2"></i>
                                        Back to Dashboard
                                    </a>
                                    <form method="POST" action="/logout" style="display:inline;">
                                        <button type="submit"
                                                style="background:transparent;color:var(--md-text-secondary);border:1px solid rgba(0,0,0,0.18);padding:0 1.25rem;height:40px;border-radius:6px;cursor:pointer;display:inline-flex;align-items:center;gap:0.4rem;font-size:0.875rem;">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Sign Out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <footer class="md-footer" role="contentinfo">
        <div class="md-container">
            <div class="md-footer-content">
                <p class="md-body-small md-text-secondary md-margin-bottom-none">
                    &copy; 2026 Delivvr. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    <!-- Mobile Navigation Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navToggle = document.getElementById('navbar-toggle');
            const navMenu = document.getElementById('navbarNav');
            
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function() {
                    const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
                    navToggle.setAttribute('aria-expanded', !isExpanded);
                    navMenu.classList.toggle('md-navbar-nav-open');
                    navToggle.classList.toggle('md-navbar-toggle-active');
                });
                
                // Close menu when clicking outside
                document.addEventListener('click', function(event) {
                    if (!navToggle.contains(event.target) && !navMenu.contains(event.target)) {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('md-navbar-nav-open');
                        navToggle.classList.remove('md-navbar-toggle-active');
                    }
                });
                
                // Close menu on escape key
                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape') {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('md-navbar-nav-open');
                        navToggle.classList.remove('md-navbar-toggle-active');
                    }
                });
            }
        });
    </script>
    
    <!-- Theme Toggle Script -->
    <script src="/js/theme-toggle.js"></script>
</body>
</html>