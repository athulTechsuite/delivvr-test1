<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - Delivvr</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="md-body">
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>

    <nav class="md-navbar" role="navigation" aria-label="Main navigation">
        <div class="md-navbar-container">
            <div class="md-navbar-brand">
                <a href="/" class="md-navbar-brand-link delivvr-brand" aria-label="Delivvr Home">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>Delivvr</span>
                </a>
            </div>
            <button class="md-navbar-toggle" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
                <span class="md-navbar-toggle-icon"></span>
            </button>
            <div class="md-navbar-nav" id="navbarNav">
                <ul class="md-navbar-menu" role="menubar">
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/dashboard" role="menuitem">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link" href="/orders" role="menuitem">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            My Orders
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <a class="md-navbar-link md-navbar-link-active" href="/profile" role="menuitem" aria-current="page">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            Profile
                        </a>
                    </li>
                    <li class="md-navbar-item" role="none">
                        <form method="POST" action="/logout" class="md-navbar-form">
                            <button type="submit" class="md-navbar-link md-navbar-link-button" role="menuitem">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                    <li class="md-navbar-item md-theme-toggle-container" role="none">
                        <button class="md-button md-button--icon theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="md-main" id="main-content" role="main">
        <div class="md-container">
            <%
                var rawName = (user && (user.name || user.username || user.email)) ? (user.name || user.username || user.email) : 'U';
                var nameParts = String(rawName).trim().split(/\s+/);
                var initials = nameParts.length > 1
                    ? (nameParts[0][0] + nameParts[1][0]).toUpperCase()
                    : String(rawName).substring(0, 2).toUpperCase();
                var displayName = (user && (user.name || user.username)) ? (user.name || user.username) : 'User';
                var memberSince = 'N/A';
                try {
                    if (user && user.created_at) {
                        var d = new Date(user.created_at);
                        if (!isNaN(d.getTime())) {
                            memberSince = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                        }
                    }
                } catch (e) { memberSince = 'N/A'; }
            %>

            <header class="md-page-header" aria-labelledby="profile-heading">
                <div>
                    <h1 id="profile-heading" class="md-page-header-title">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        Your Profile
                    </h1>
                    <p class="md-page-header-subtitle">View your account details and preferences.</p>
                </div>
            </header>

            <section class="md-section md-margin-bottom-lg" aria-labelledby="profile-info-heading">
                <h2 id="profile-info-heading" class="md-visually-hidden">Profile information</h2>
                <div class="md-row md-justify-center">
                    <div class="md-col-12 md-col-md-10 md-col-lg-8">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <!-- Avatar header -->
                            <div class="md-section-card md-text-center">
                                <div class="md-avatar md-primary md-avatar-large" aria-hidden="true"><%= initials %></div>
                                <h2 class="md-section-card-title md-margin-top-sm md-display-block">
                                    <%= displayName %>
                                </h2>
                                <p class="md-section-card-subtitle">
                                    Delivvr Member
                                    <span class="md-badge md-badge-delivered" aria-label="Account active">
                                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                        Active
                                    </span>
                                </p>
                            </div>

                            <!-- Account details -->
                            <div class="md-section-card" role="region" aria-labelledby="account-section">
                                <h3 id="account-section" class="md-section-card-title">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                                    Account Information
                                </h3>
                                <div class="md-profile-info-list">
                                    <div class="md-profile-item">
                                        <i class="bi bi-person-fill" aria-hidden="true"></i>
                                        <span class="label">Full Name</span>
                                        <span class="value" id="profile-name"><%= typeof user.name === 'string' ? user.name : (user.username || 'N/A') %></span>
                                    </div>
                                    <div class="md-profile-item">
                                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                                        <span class="label">Email</span>
                                        <span class="value" id="profile-email"><%= typeof user.email === 'string' ? user.email : 'N/A' %></span>
                                    </div>
                                    <% if (user.username) { %>
                                    <div class="md-profile-item">
                                        <i class="bi bi-at" aria-hidden="true"></i>
                                        <span class="label">Username</span>
                                        <span class="value"><%= user.username %></span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Membership / status -->
                            <div class="md-section-card" role="region" aria-labelledby="membership-section">
                                <h3 id="membership-section" class="md-section-card-title">
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    Membership &amp; Status
                                </h3>
                                <div class="md-profile-info-list">
                                    <div class="md-profile-item">
                                        <i class="bi bi-calendar-check-fill" aria-hidden="true"></i>
                                        <span class="label">Member since</span>
                                        <span class="value" id="profile-join-date"><%= memberSince %></span>
                                    </div>
                                    <div class="md-profile-item">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                                        <span class="label">Status</span>
                                        <span class="value">
                                            <span class="md-badge md-badge-delivered">
                                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                                Active
                                            </span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="md-section-card">
                                <div class="md-button-group md-gap-sm">
                                    <a href="/dashboard" class="md-btn md-button md-btn-primary md-button--contained" aria-label="Back to Dashboard">
                                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                        <span>Back to Dashboard</span>
                                    </a>
                                    <form method="POST" action="/logout" class="md-navbar-form">
                                        <button type="submit" class="md-btn md-button md-button--outlined" aria-label="Sign Out">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="md-section-card md-profile-error" role="alert" aria-live="polite">
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                <div>
                                    <strong>Profile Unavailable</strong>
                                    <p class="md-margin-none md-body2">
                                        We're unable to load your profile information. Please refresh or contact support.
                                    </p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <footer class="md-footer" role="contentinfo">
        <div class="md-container">
            <p class="md-body2 md-text-secondary md-text-center md-margin-none">&copy; 2026 Delivvr. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/theme-toggle.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navToggle = document.querySelector('.md-navbar-toggle');
            var navMenu = document.querySelector('.md-navbar-nav');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function () {
                    var expanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !expanded);
                    navMenu.classList.toggle('show');
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && navMenu.classList.contains('show')) {
                        navToggle.setAttribute('aria-expanded', 'false');
                        navMenu.classList.remove('show');
                    }
                });
            }
        });
    </script>
</body>
</html>
