{
  "name": "express-auth-app",
  "version": "1.0.0",
  "description": "Express.js application with authentication features using JWT and bcrypt",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --setupFiles ./test/jest-setup.js"
  },
  "keywords": [
    "express",
    "authentication",
    "jwt",
    "bcrypt",
    "sqlite",
    "ejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "cookie-parser": "^1.4.6",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.test.js",
      "<rootDir>/spec/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.claude/"
    ]
  }
}