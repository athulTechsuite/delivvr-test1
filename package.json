{
  "name": "express-auth-app",
  "version": "1.0.0",
  "description": "Express.js application with authentication features using JWT and bcrypt",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --testPathPatterns=test/app.test.js --testNamePattern=\"GET /health\""
  },
  "keywords": [
    "express",
    "authentication",
    "jwt",
    "bcrypt",
    "sqlite",
    "ejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "cookie-parser": "^1.4.6",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jest-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/",
      "\\.test\\.ts$"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/\\.claude/",
      "<rootDir>/delivvr-test1/"
    ]
  }
}
